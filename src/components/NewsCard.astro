---
interface Props { image?: string; category: string; date: string; title: string; excerpt?: string; href: string; light?: boolean; headingLevel?: 2 | 3 }
const { image, category, date, title, excerpt, href, light = false, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
---
<a href={href} class:list={['nc reveal', { 'nc--light': light }]}>
  <div class="nc__media img-zoom">
    {image && <img src={image} alt="" width="800" height="450" loading="lazy" decoding="async" />}
  </div>
  <span class="type-mono nc__meta">{category} · {date}</span>
  <H class="nc__h">{title}</H>
  {excerpt && <p class="nc__p">{excerpt}</p>}
</a>
<style>
  .nc{display:flex;flex-direction:column;gap:12px;text-decoration:none;color:#fff}
  .nc__media{aspect-ratio:16/9;background:#1A1A1A;border-bottom:2px solid transparent;transition:border-color var(--dur-base) var(--ease-out)}
  .nc__media img{width:100%;height:100%;object-fit:cover}
  .nc:hover .nc__media,.nc:focus-visible .nc__media{border-color:currentColor}
  .nc__meta{color:var(--grigio-450);letter-spacing:.08em}
  .nc__h{font-family:var(--font-display);font-stretch:125%;font-weight:600;font-size:19px;line-height:1.25;text-underline-offset:4px}
  .nc:hover .nc__h,.nc:focus-visible .nc__h{text-decoration:underline}
  .nc__p{font-size:15px;color:var(--text-body-on-dark)}
  .nc--light{color:var(--nero)}
  .nc--light .nc__media{background:#F2F2F2}
  .nc--light .nc__meta{color:#6B6B6B}
  .nc--light .nc__p{color:var(--text-secondary)}
</style>
