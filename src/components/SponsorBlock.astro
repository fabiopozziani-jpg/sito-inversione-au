---
import type { Sponsor } from '../data/sponsor';
/** Griglia loghi. mono=true → monocromo (guscio del sito); mono=false → colore (hub evento). */
interface Props { title?: string; sponsors: Sponsor[]; columns?: number; light?: boolean; mono?: boolean; headingLevel?: 2 | 3; logoH?: number }
const { title, sponsors, columns = 4, light = false, mono = true, headingLevel = 2, logoH = 46 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
---
<div class:list={['spb sponsor-fade', { 'spb--light': light, 'spb--mono': mono }]} style={`--c:${columns};--logo-h:${logoH}px`}>
  {title && <H class="type-mono spb__h">{title}</H>}
  <ul class="spb__grid">
    {sponsors.map(s => (
      <li class="spb__cell">
        {s.url
          ? <a href={s.url} target="_blank" rel="noopener">{s.logo ? <img src={s.logo} alt={s.name} width={s.w} height={s.h} loading="lazy" decoding="async" /> : <span class="spb__nome">{s.name}</span>}</a>
          : s.logo ? <img src={s.logo} alt={s.name} width={s.w} height={s.h} loading="lazy" decoding="async" /> : <span class="spb__nome">{s.name}</span>}
      </li>
    ))}
  </ul>
</div>
<script>
  // Un logo che non carica (file rimosso dal Media Manager) mostra il nome,
  // come già succede quando il logo manca del tutto. Mai l'icona di immagine rotta.
  document.addEventListener('error', (e) => {
    const img = e.target as HTMLImageElement;
    if (!(img instanceof HTMLImageElement) || !img.closest('.spb__cell')) return;
    const span = document.createElement('span');
    span.className = 'spb__nome';
    span.textContent = img.alt;
    for (const a of Array.from(img.attributes)) if (a.name.startsWith('data-astro')) span.setAttribute(a.name, a.value);
    img.replaceWith(span);
  }, true);
</script>
<style>
  .spb__h{color:var(--grigio-450);letter-spacing:.08em;margin-bottom:24px}
  .spb__grid{display:grid;grid-template-columns:repeat(var(--c),minmax(0,1fr));gap:1px;background:var(--border-on-dark);border:1px solid var(--border-on-dark)}
  .spb__cell{background:var(--nero);aspect-ratio:2/1;display:flex;align-items:center;justify-content:center;padding:16px}
  .spb__cell img{max-width:76%;max-height:var(--logo-h,46px);width:auto;height:auto;opacity:.8;transition:opacity var(--dur-base) var(--ease-out)}
  @media(min-width:1180px){.spb__cell img{max-height:calc(var(--logo-h,46px) + 8px)}}
  .spb__cell:hover img{opacity:1}
  .spb__nome{font-family:var(--font-mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;text-align:center;color:var(--grigio-450);line-height:1.3;overflow-wrap:anywhere}
  .spb--light .spb__nome{color:#6B6B6B}
  .spb--mono .spb__cell img{filter:grayscale(1) brightness(0) invert(1)}
  .spb--light .spb__grid{background:var(--border-divider);border-color:var(--border-divider)}
  .spb--light .spb__cell{background:var(--bianco)}
  .spb--light .spb__h{color:#6B6B6B}
  .spb--light.spb--mono .spb__cell img{filter:grayscale(1)}
  @media(max-width:900px){.spb__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:560px){.spb__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.spb__grid>*:last-child:nth-child(odd){grid-column:span 2}}
</style>
