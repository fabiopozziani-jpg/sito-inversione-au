---
/**
 * Striscia scorrevole di foto: overflow nativo + scroll-snap, la foto successiva resta tagliata a metà.
 * Nessun avanzamento automatico. Frecce solo da 900px in su. Le miniature aprono la Lightbox globale.
 */
import type { Foto } from '../data/gallerie';
interface Props { foto: Foto[]; title: string; intro?: string; href: string; label?: string; credito?: string; id?: string; full?: boolean }
const { foto, title, intro, href, label = 'Guarda tutte le foto', credito = 'Foto: Inversione A U', id = 'foto', full = false } = Astro.props;
---
<section class:list={['ps', { 'ps--full': full }]} data-gallery data-credito={credito} aria-labelledby={`${id}-h`}>
  <div class="ps__head">
    <div class="ps__t">
      <h2 id={`${id}-h`} class="type-h2">{title}</h2>
      {intro && <p class="ps__intro">{intro}</p>}
    </div>
    <div class="ps__arrows">
      <button type="button" class="ps__arrow" data-ps-prev aria-label="Scorri le foto verso sinistra">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button type="button" class="ps__arrow" data-ps-next aria-label="Scorri le foto verso destra">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
  <ul class="ps__track" data-ps-track>
    {foto.map((f, i) => (
      <li>
        <button type="button" class="ps__btn" data-lb data-src={f.srcLarge} data-alt={f.alt} aria-label={`Ingrandisci: ${f.alt}`}>
          <img src={f.src} srcset={`${f.src} 400w, ${f.src800} 800w, ${f.srcLarge} 1600w`} sizes="(max-width:900px) 78vw, 30vw" alt={f.alt} width={f.w} height={f.h} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" fetchpriority={i === 0 ? 'high' : 'auto'} />
        </button>
      </li>
    ))}
  </ul>
  <div class="ps__more"><a class="type-mono link-line" href={href}>{label} <span class="arrow-x" aria-hidden="true">→</span></a></div>
</section>
<style>
  .ps__head{display:flex;justify-content:space-between;align-items:flex-end;gap:var(--sp-3);flex-wrap:wrap;margin-bottom:var(--sp-3)}
  .ps__t{min-width:0}
  .ps__t h2{color:#fff;margin-bottom:8px}
  .ps__intro{color:var(--text-body-on-dark);max-width:62ch}
  .ps__arrows{display:none;gap:var(--sp-2)}
  @media(min-width:900px){.ps__arrows{display:flex}}
  .ps__arrow{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border:1px solid var(--border-on-dark);color:#fff;transition:background-color var(--dur-fast) var(--ease-out),color var(--dur-fast) var(--ease-out)}
  .ps__arrow:hover,.ps__arrow:focus-visible{background:#fff;color:#000}
  .ps__track{display:flex;gap:var(--sp-2);overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:var(--grid-margin);scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .ps__track::-webkit-scrollbar{display:none}
  .ps__track>li{flex:0 0 78%;scroll-snap-align:start}
  /* full: la striscia esce dalla colonna e arriva ai bordi dello schermo (titoli e link restano allineati) */
  .ps--full .ps__track{margin-inline:calc(50% - 50vw);padding-inline:var(--grid-margin);scroll-padding-inline:var(--grid-margin);max-width:100vw}
  @media(min-width:900px){.ps--full .ps__track>li{flex:0 0 clamp(280px,22vw,420px)}}
  @media(min-width:900px){.ps__track>li{flex:0 0 30%}}
  .ps__btn{display:block;width:100%;background:#1A1A1A;aspect-ratio:3/2;overflow:hidden}
  .ps__btn img{width:100%;height:100%;object-fit:cover;transition:transform var(--dur-base) var(--ease-out),opacity var(--dur-base) var(--ease-out)}
  .ps__btn:hover img,.ps__btn:focus-visible img{transform:scale(1.03);opacity:.88}
  .ps__more{margin-top:var(--sp-3)}
  .ps__more a{color:#fff}
  @media (prefers-reduced-motion:reduce){.ps__btn img{transition:none;transform:none!important}}
</style>
<script>
  document.querySelectorAll<HTMLElement>('.ps').forEach(sec => {
    const track = sec.querySelector<HTMLElement>('[data-ps-track]')!;
    const go = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.85, behavior: 'smooth' });
    sec.querySelector('[data-ps-prev]')?.addEventListener('click', () => go(-1));
    sec.querySelector('[data-ps-next]')?.addEventListener('click', () => go(1));
  });
</script>
