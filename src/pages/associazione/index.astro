---
/** Associazione — chi siamo, come lavoriamo, numeri, storia, direttivo, trasparenza, tesseramento. */
import '../../styles/hub.css';
import Base from '../../layouts/Base.astro';
import { caricaTeam } from '../../lib/contenuti';
import { IMMAGINI, imgFill, imgFit } from '../../data/rallyImmagini';
import { srcsetFill } from '../../data/media';
const heroStaff = imgFill(IMMAGINI.staff, 1920, 1080);
import { documenti as pdfWix } from '../../data/filesWix';
import StatBlock from '../../components/StatBlock.astro';
import Timeline from '../../components/Timeline.astro';
import CTABlock from '../../components/CTABlock.astro';
const email = 'inversione.au3@gmail.com';
const numeri = [
  { value: '10.000+', label: 'spettatori' }, { value: 'circa 100', label: 'equipaggi in due giorni' }, { value: '400+', label: 'auto esposte' },
  { value: '30+', label: 'persone nello staff' }, { value: '23', label: 'sponsor e partner' }, { value: '8', label: 'fotografi e videomaker' },
];
const storia = [
  { time: '2017', title: 'Il team drift', text: 'Inversione A U nasce come team amatoriale legato al drifting e alla cultura automobilistica, con la partecipazione agli eventi del Nord Italia.' },
  { time: '2018', title: 'I primi raduni', text: 'L’attività si sposta dalla partecipazione all’organizzazione: nascono i primi raduni dedicati all’automobile.' },
  { time: '2022', title: 'Dagli statici agli eventi dinamici', text: 'Primo anno da organizzatori di eventi dinamici su piazzali e circuiti cittadini, con l’ingresso nell’organizzazione del Polo Motor Show.' },
  { time: '2023', title: 'Nasce l’Associazione Sportiva Dilettantistica', text: 'L’esperienza maturata negli anni diventa una struttura: atto costitutivo, statuto, consiglio direttivo e libro dei soci.' },
  { time: '2024–2025', title: 'Il Polo Motor Show cresce', text: 'Il circuito cittadino di Selve di Teolo consolida il format, con la finale italiana dell’Hot Wheels Legends Tour nel 2025.' },
  { time: '2026', title: 'Tre format, tre discipline', text: 'Legnaro Motori a marzo, Polo Motor Show a giugno e, a novembre, il 1° Rally Colli Euganei: dopo più di 35 anni torna un rally nel Padovano.' },
];
const direttivoStatico = [
  { nome: 'Matteo Pescante', ruolo: 'Presidente', nota: 'Rappresenta legalmente l’associazione e coordina le attività istituzionali e organizzative.' },
  { nome: 'Andrea D’Alberto', ruolo: 'Vicepresidente', nota: 'Supporta la presidenza e coordina le attività operative e organizzative legate agli eventi.' },
  { nome: 'Matteo Casarin', ruolo: 'Tesoriere', nota: 'Cura gli aspetti economici e amministrativi e i rapporti con sponsor, fornitori e partner.' },
  { nome: 'Fabio Pozziani', ruolo: 'Segretario', nota: 'Gestisce documenti, verbali, libro soci e comunicazioni istituzionali.' },
  { nome: 'Thomas Scapocchin', ruolo: 'Consigliere', nota: 'Collabora alle attività sportive e operative: percorsi, pista e sicurezza.' },
];
const direttivo = (await caricaTeam()) ?? direttivoStatico;
const dati: [string, string][] = [
  ['Denominazione', 'Associazione Sportiva Dilettantistica Inversione A U'], ['Sigla', 'A.S.D. Inversione A U'], ['Sede legale', 'Via Selve 46/B · Saccolongo (PD)'],
  ['Codice fiscale', '92324000287'], ['Partita IVA', '05585020281'], ['Costituita il', '20 novembre 2023'], ['Codice attività', '931910 · Enti e organizzazioni sportive'],
];
const documenti = [
  { label: 'Atto costitutivo e statuto', href: pdfWix.statuto },
  { label: 'Modello di Safeguarding', href: pdfWix.safeguarding, nota: 'Politiche per la tutela dei minori e dei tesserati' },
  { label: 'Certificato del codice fiscale', href: pdfWix.codiceFiscale },
  { label: 'Certificato della partita IVA', href: pdfWix.partitaIva },
];
const tessere = ['Nuovo tesseramento', 'Rinnovo del tesseramento'];
---
<Base title="Associazione motorsport a Padova | Inversione A U" description="Inversione A U, associazione sportiva dilettantistica di Padova: team drift dal 2017, A.S.D. dal 2023. Organizza Legnaro Motori, Polo Motor Show e il rally." active="associazione">
  <section class="hero" aria-labelledby="hero-h1">
    <img class="hero__img" src={heroStaff} srcset={srcsetFill(heroStaff) || undefined} sizes="100vw" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="wrap hero__in">
      <p class="type-mono hero__kicker">Associazione sportiva dilettantistica · Padova</p>
      <h1 id="hero-h1" class="hero__h1"><span class="type-display">Inversione A U</span><span class="hero__sub">Motorsport, organizzazione e territorio</span></h1>
      <p class="type-mono hero__meta">Costituita nel 2023 · attivi dal 2017</p>
      <div><a href="#tesseramento" class="btn btn--primary">Diventa Tesserato</a></div>
    </div>
  </section>

  <section id="chi-siamo" class="wrap section chi" aria-labelledby="chi-h">
    <div class="chi__t">
      <p class="type-mono text-meta">Chi siamo</p>
      <h2 id="chi-h" class="type-h2 reveal-wipe"><span>Chi siamo e cosa organizziamo</span></h2>
      <p>Inversione A U A.S.D. è un'associazione sportiva dilettantistica nata dall'esperienza diretta nel motorsport, oggi impegnata nella progettazione, nell'organizzazione e nella gestione di eventi automobilistici.</p>
      <p>Dal 2017 abbiamo costruito un percorso che ci ha portati dall'attività sportiva e dalla partecipazione agli eventi alla gestione diretta di manifestazioni sempre più strutturate.</p>
      <p>Operiamo attraverso un'organizzazione stabile, un consiglio direttivo e una rete di collaboratori, tecnici, professionisti e volontari: eventi accessibili, sicuri e professionalmente organizzati.</p>
    </div>
    <div class="chi__img img-zoom reveal"><img src={imgFill(IMMAGINI.twinDrift, 1200, 900)} alt={IMMAGINI.twinDrift.alt} loading="lazy" decoding="async" width="1200" height="900" /></div>
  </section>

  <section id="mission" class="wrap section" aria-labelledby="mis-h">
    <h2 id="mis-h" class="type-h2">Il nostro modo di fare motorsport</h2>
    <p class="type-body-dark sec-intro">Competenza, sicurezza e collaborazione. Organizzare un evento automobilistico significa coordinare persone, strutture, regolamenti, istituzioni e pubblico: lo facciamo lavorando su tre principi.</p>
    <div class="reg stagger">
      {[
        ['01', 'Organizzazione', 'Ogni manifestazione nasce da una pianificazione strutturata che coinvolge enti, fornitori, partner, partecipanti e personale operativo: percorso, aree, logistica e comunicazione.'],
        ['02', 'Sicurezza', 'Procedure, regolamenti, personale dedicato e coordinamento con gli organismi competenti sono parte della progettazione. Per le attività sportive valgono i regolamenti degli enti e delle federazioni di riferimento.'],
        ['03', 'Territorio', 'Gli eventi non vengono organizzati in un territorio: vengono costruiti insieme al territorio. Comuni, enti, associazioni locali e comunità ospitanti sono parte del lavoro.'],
      ].map(([n, t, d]) => <div class="card reg__c reveal"><span class="type-mono text-meta">{n}</span><h3 class="type-h3">{t}</h3><p>{d}</p></div>)}
    </div>
  </section>

  <section id="numeri" class="wrap section num" aria-labelledby="num-h">
    <div class="num__t">
      <h2 id="num-h" class="type-h2">I nostri numeri</h2>
      <p class="type-body-dark">Tre eventi in un anno, una sola struttura organizzativa.</p>
      <p class="hint">Dati riferiti alle ultime edizioni del Polo Motor Show</p>
    </div>
    <div class="num__n"><StatBlock stats={numeri} columns={2} /></div>
  </section>

  <section id="storia" class="wrap section" aria-labelledby="sto-h">
    <h2 id="sto-h" class="type-h2">Una struttura nata dal motorsport</h2>
    <p class="type-body-dark sec-intro">Dalla passione all'organizzazione. La costituzione dell'associazione, nel 2023, trasforma l'esperienza maturata sul campo in una struttura capace di gestire direttamente eventi sportivi, rapporti istituzionali e attività rivolte al pubblico.</p>
    <Timeline items={storia} />
  </section>

  <section id="direttivo" class="on-light" aria-labelledby="dir-h">
    <div class="wrap section">
      <h2 id="dir-h" class="type-h2">Il consiglio direttivo</h2>
      <p class="sec-intro dir__intro">Le persone che guidano l'associazione. Il consiglio direttivo è l'organo di indirizzo e gestione: le diverse competenze dei suoi componenti coprono gli aspetti organizzativi, amministrativi, istituzionali e sportivi.</p>
      <ul class="dir stagger">
        {direttivo.map(d => <li class="dir__c reveal"><h3 class="type-h3">{d.nome}</h3><span class="type-mono dir__r">{d.ruolo}</span><p>{d.nota}</p></li>)}
      </ul>
    </div>
  </section>

  <section id="trasparenza" class="wrap section tra" aria-labelledby="tra-h">
    <div class="tra__t">
      <h2 id="tra-h" class="type-h2">Documenti e dati dell'associazione</h2>
      <p class="type-body-dark">Dati fiscali, atto costitutivo e statuto: quello che serve per fatturare, firmare o controllare.</p>
      <dl class="tra__dl">
        {dati.map(([k, v]) => <div><dt class="type-mono">{k}</dt><dd>{v}</dd></div>)}
        <div><dt class="type-mono">Email</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></div>
      </dl>
    </div>
    <ul class="tra__docs">
      {documenti.map(d => (
        <li>
          {d.href
            ? <a class="tra__doc" href={d.href} target="_blank" rel="noopener"><span class="tra__doc-t">{d.label}</span><span class="hint">{d.nota ? `${d.nota} · ` : ''}PDF · si apre in una nuova pagina ↗</span></a>
            : <span class="tra__doc tra__doc--off"><span class="tra__doc-t">{d.label}</span><span class="hint">{d.nota ? `${d.nota} · ` : ''}PDF in pubblicazione</span></span>}
        </li>
      ))}
    </ul>
  </section>

  <section id="tesseramento" class="hair" aria-labelledby="tes-h">
    <div class="wrap section tes">
      <div class="tes__t">
        <h2 id="tes-h" class="type-h2">Diventa parte di Inversione A U</h2>
        <p class="type-body-dark">Tesserati, collaboratori e appassionati.</p>
        <p class="tes__p">L'associazione è aperta a chi vuole partecipare alle sue attività e contribuire allo sviluppo dei progetti. Al momento non ci sono posti disponibili come socio: ci si può tesserare per l'anno in corso oppure rinnovare il tesseramento.</p>
        <ul class="lista-ev tes__list">
          <li>Nuovo tesseramento — per chi entra per la prima volta nelle attività dell'associazione</li>
          <li>Rinnovo — per chi era già tesserato l'anno precedente</li>
          <li>Chi vuole dare una mano agli eventi può segnalarlo nella richiesta: la squadra si costruisce così</li>
          <li>La tessera vale per l'anno solare. Il rinnovo si apre a gennaio.</li>
        </ul>
      </div>
      <form class="tes__form" data-mailform data-modulo="richieste" data-to={email} data-subject="Richiesta tessera · Inversione A U" novalidate>
        <input type="hidden" name="contesto" value="tessera" />
        <h3 class="type-h3">Richiedi la tessera</h3>
        <label class="field"><span>Nome e cognome</span><input type="text" name="nome" placeholder="Es. Marco Franceschetti" autocomplete="name" required /></label>
        <label class="field"><span>Email</span><input type="email" name="email" placeholder="nome@email.it" autocomplete="email" required /></label>
        <label class="field"><span>Tipo di richiesta</span><select name="tessera">{tessere.map(t => <option value={t}>{t}</option>)}</select></label>
        <label class="chk"><input type="checkbox" name="privacy" required /><span>Ho letto l'<a href="/privacy/">informativa privacy</a> e acconsento al trattamento dei dati per rispondere alla richiesta.</span></label>
        <button type="submit" class="btn btn--primary tes__btn">Invia la richiesta</button>
        <p class="form-msg" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section id="eventi" class="wrap section" aria-labelledby="ev-h">
    <h2 id="ev-h" class="type-h2">Gli eventi di Inversione A U</h2>
    <p class="type-body-dark sec-intro">Tre manifestazioni, un'unica organizzazione. Durante l'anno sviluppiamo eventi differenti per format, pubblico e disciplina, mantenendo lo stesso approccio organizzativo.</p>
    <div class="reg stagger">
      {[
        ['Legnaro Motori', 'Un appuntamento dedicato alla cultura automobilistica e al mondo dei motori.', '/eventi/legnaro-motori/'],
        ['Polo Motor Show', 'Una manifestazione che unisce motorsport, spettacolo, esposizione e pubblico attraverso un circuito cittadino.', '/eventi/polo-motor-show/'],
        ['Rally Colli Euganei', 'Una competizione automobilistica che riporta il rally sui Colli Euganei attraverso un\'organizzazione sportiva strutturata.', '/rally-colli-euganei/'],
      ].map(([t, d, href]) => (
        <a class="card reg__c ev__c reveal" href={href}>
          <h3 class="type-h3">{t}</h3>
          <p>{d}</p>
          <span class="type-mono ev__go">Apri la pagina <span class="arrow-x" aria-hidden="true">&#8594;</span></span>
        </a>
      ))}
    </div>
  </section>

  <CTABlock kicker="Una squadra, una struttura, un obiettivo" title="Portare il motorsport fuori dai soliti circuiti" text="Organizziamo eventi che abbiano valore sportivo, qualità organizzativa e una relazione forte con il pubblico e con il territorio.">
    <a href="/eventi/" class="btn btn--primary">Vedi il calendario</a>
    <a href="/eventi/archivio/" class="btn btn--secondary">Apri l'archivio</a>
  </CTABlock>
</Base>
<script>import '../../scripts/mailform';</script>
<style>
  .hero{position:relative;height:64vh;min-height:460px;background:var(--nero);overflow:hidden;display:flex}
  .hero__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .hero__scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.2) 0%,rgba(0,0,0,.75) 100%)}
  .hero__in{position:relative;align-self:flex-end;width:100%;padding-bottom:var(--sp-7,56px);display:flex;flex-direction:column;gap:14px;color:#fff}
  .hero__kicker{color:var(--grigio-200)}
  .hero__h1{display:flex;flex-direction:column;gap:8px;color:#fff}
  .hero__h1 .type-display{font-size:clamp(40px,7vw,96px)}
  .hero__sub{font-family:var(--font-display);font-stretch:125%;font-weight:600;text-transform:uppercase;letter-spacing:.04em;font-size:clamp(16px,2vw,24px)}
  .hero__meta{color:var(--grigio-200)}
  h2{color:#fff}
  .on-light h2{color:var(--nero)}
  .sec-intro{max-width:56ch;margin:8px 0 var(--sp-4)}
  .chi{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-6);align-items:center}
  @media(min-width:900px){.chi{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr)}}
  .chi__t{display:flex;flex-direction:column;gap:14px}
  .chi__t p:not(.type-mono){color:#DDD;max-width:56ch}
  .chi__img{aspect-ratio:4/3;overflow:hidden;background:#1A1A1A}
  .chi__img img{width:100%;height:100%;object-fit:cover}
  .reg{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--grid-gutter)}
  @media(min-width:768px){.reg{grid-template-columns:repeat(3,minmax(0,1fr))}}
  .reg__c h3{color:#fff}
  .ev__c{text-decoration:none;display:flex;flex-direction:column;gap:12px;transition:border-color var(--dur-fast) var(--ease-out)}
  .ev__c:hover,.ev__c:focus-visible{border-color:#fff}
  .ev__go{color:var(--grigio-450);margin-top:auto}
  .ev__c:hover .ev__go{color:#fff}
  .num{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-6);align-items:start}
  @media(min-width:900px){.num{grid-template-columns:minmax(0,1fr) minmax(0,1.2fr)}}
  .num__t{display:flex;flex-direction:column;gap:12px}
  .dir__intro{color:var(--text-secondary)}
  .dir{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--grid-gutter)}
  @media(min-width:640px){.dir{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(min-width:1024px){.dir{grid-template-columns:repeat(5,minmax(0,1fr))}}
  .dir__c{border-top:2px solid var(--nero);padding-top:16px;display:flex;flex-direction:column;gap:8px}
  .dir__c h3{font-size:18px}
  .dir__r{color:#6B6B6B}
  .dir__c p{color:var(--text-secondary);font-size:15px}
  .tra{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-6);align-items:start}
  @media(min-width:900px){.tra{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr)}}
  .tra__t{display:flex;flex-direction:column;gap:12px}
  .tra__dl{display:flex;flex-direction:column;border-top:1px solid var(--border-on-dark);margin-top:8px}
  .tra__dl div{display:grid;grid-template-columns:minmax(0,1fr);gap:4px;padding:12px 0;border-bottom:1px solid var(--border-on-dark)}
  @media(min-width:520px){.tra__dl div{grid-template-columns:180px 1fr;gap:16px}}
  .tra__dl dt{color:var(--grigio-450)}
  .tra__dl dd{margin:0;color:#fff}
  .tra__dl a{color:#fff}
  .tra__docs{display:flex;flex-direction:column;gap:12px}
  .tra__doc{display:flex;flex-direction:column;gap:6px;padding:20px 24px;background:var(--carbone);border:1px solid var(--border-on-dark);text-decoration:none;color:#fff;transition:border-color var(--dur-fast) var(--ease-out)}
  .tra__doc:hover,.tra__doc:focus-visible{border-color:#fff}
  .tra__doc--off{color:var(--grigio-450);border-style:dashed}
  .tra__doc--off:hover{border-color:var(--border-on-dark)}
  .tra__doc-t{font-family:var(--font-mono);font-size:13px;letter-spacing:.06em;text-transform:uppercase}
  .tes{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-6);align-items:start}
  @media(min-width:900px){.tes{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr)}}
  .tes__t{display:flex;flex-direction:column;gap:12px}
  .tes__p{color:#DDD;max-width:56ch}
  .tes__list{margin-top:8px}
  .tes__form{display:flex;flex-direction:column;gap:18px;background:var(--carbone);border:1px solid var(--border-on-dark);padding:var(--sp-4)}
  .tes__form h3{color:#fff}
  .tes__btn{width:100%}
</style>
