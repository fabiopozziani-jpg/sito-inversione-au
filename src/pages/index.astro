---
/**
 * Home — struttura approvata: hero rally · accesso rapido · stagione (gerarchia Rally > Polo > Legnaro)
 * · chi siamo + numeri · notizie · foto · partner · chiusura.
 * Testi: Ondata 5. Foto: FASE 2 da /public, FASE 3 da Wix Media.
 */
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import EventCard from '../components/EventCard.astro';
import StatBlock from '../components/StatBlock.astro';
import NewsCard from '../components/NewsCard.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import SponsorBlock from '../components/SponsorBlock.astro';
import SocialStrip from '../components/SocialStrip.astro';
import CTABlock from '../components/CTABlock.astro';
import { numeri } from '../data/eventi';
import { rallyImg, RALLY_IMG, IMMAGINI, imgFit } from '../data/rallyImmagini';
import { srcsetFill } from '../data/media';
const heroHome = rallyImg(RALLY_IMG.heroHome, 1920, 1080);
import { caricaEventi, caricaPosts, ordinaPerData, caricaGallerie, fotoRecentiDa, caricaSponsor, caricaSocial } from '../lib/contenuti';
const [eventiTutti, tuttiIPost, gallerie, sponsor, social] = await Promise.all([caricaEventi(), caricaPosts(), caricaGallerie(), caricaSponsor(), caricaSocial()]);
const trova = (k: string) => eventiTutti.find(e => e.key === k)!;
const eventi = [trova('rally'), trova('polo'), trova('legnaro')];
const annuali = sponsor.annuali;
const fotoRecenti = (n: number) => fotoRecentiDa(gallerie, n);

const [rally, polo, legnaro] = eventi;
const inizio = new Date('2026-11-21T08:00:00+01:00'), fine = new Date('2026-11-22T20:00:00+01:00');
const now = Date.now();
const giorni = Math.ceil((inizio.getTime() - now) / 864e5);
const countdown = now > fine.getTime() ? 'Edizione conclusa'
  : now >= inizio.getTime() ? 'Gara in corso'
  : giorni === 1 ? 'T−1 giorno al via · domani'
  : `T−${giorni} giorni al via`;

// Ultime tre notizie per data (CMS News, riserva statica).
const news = ordinaPerData(tuttiIPost).slice(0, 3).map(p => ({ image: p.image, category: p.category, date: p.date, title: p.title, excerpt: p.excerpt, href: `/news/${p.slug}/` }));
---
<Base
  title="Eventi motorsport in Veneto | Inversione A U"
  description="Rally, drift e raduni sui Colli Euganei: il 1° Rally Colli Euganei ACI Sport è il 21 e 22 novembre 2026. Calendario, percorso e informazioni per il pubblico."
  active=""
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-h1">
    <img class="hero__img" src={heroHome} srcset={srcsetFill(heroHome) || undefined} sizes="100vw" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="wrap hero__in">
      <img class="hero__targa" src={imgFit(IMMAGINI.targaRally, 1400)} alt="" width="1400" height="643" fetchpriority="high" decoding="async" />
      <p class="type-mono hero__kicker">Prossimo evento · 21–22 novembre 2026 · Colli Euganei</p>
      <h1 id="hero-h1" class="hero__h1">
        <span class="type-mono hero__name">Inversione A U</span>
        <span class="hero__sub">Torna il rally sui Colli Euganei</span>
      </h1>
      <p class="type-mono tabellone hero__count"><span class="cifra">{countdown}</span></p>
      <div class="hero__cta">
        <a href="/rally-colli-euganei/percorso/" class="btn btn--primary">Guarda il percorso</a>
        <a href="/rally-colli-euganei/" class="btn btn--secondary">Leggi le informazioni del rally <span class="arrow-x" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ACCESSO RAPIDO -->
  <nav class="accesso" aria-label="Accesso rapido">
    <div class="wrap">
    <ul class="accesso__grid">
      {[
        ['01', 'Piloti e navigatori', 'Iscrizioni, scadenze, elenco iscritti', '/rally-colli-euganei/concorrenti/'],
        ['02', 'Spettatori', 'Programma, dove vedere le prove, come arrivare', '/rally-colli-euganei/spettatori/'],
        ['03', 'Documenti di gara', 'Regolamento, ordini di partenza, comunicati', '/rally-colli-euganei/documenti/'],
        ['04', 'Giornalisti e fotografi', 'Come richiedere l\'accredito', '/stampa/accrediti/'],
      ].map(([n, t, d, h]) => (
        <li><a href={h}><span class="type-mono accesso__n">{n}</span><span class="type-mono accesso__t">{t}</span><span class="accesso__d">{d}</span></a></li>
      ))}
    </ul>
    </div>
  </nav>

  <!-- STAGIONE -->
  <section class="wrap section" aria-labelledby="stagione">
    <SectionHead id="stagione" title="Gli eventi della stagione 2026" intro="Tre eventi in provincia di Padova: una giornata drift, due giorni di circuito cittadino e un rally." href="/eventi/" label="Vedi il calendario completo" wipe />
    <div class="stagione stagger">
      <div class="stagione__rally"><EventCard e={rally} big /></div>
      <div class="stagione__polo"><EventCard e={polo} big /></div>
      <div class="stagione__legnaro"><EventCard e={legnaro} big /></div>
      <div class="stagione__next reveal">
        <div class="stagione__next-t">
          <span class="type-mono text-meta">Prossima stagione</span>
          <h3 class="type-h3">Calendario 2027</h3>
          <p class="type-body-dark">Le date del 2027 saranno pubblicate nei prossimi mesi. Lasciaci la tua email e te le mandiamo.</p>
        </div>
        <a href="/contatti/" class="btn btn--secondary">Ricevi le date via email</a>
      </div>
    </div>
  </section>

  <!-- CHI SIAMO + NUMERI -->
  <section class="wrap chi" aria-labelledby="chi-h">
    <div class="chi__t">
      <p class="type-mono text-meta chi__k">L'associazione</p>
      <h2 id="chi-h" class="type-h2">Chi è Inversione A U</h2>
      <p class="chi__p">Siamo nati nel 2017 come team di drifting. Nel 2019 abbiamo organizzato i primi raduni, dal 2022 gli eventi dinamici. Nel 2023 siamo diventati un'associazione sportiva dilettantistica.</p>
      <p class="chi__p">Oggi lavoriamo con ACI Sport, i Comuni dei Colli e le Pro Loco. Il nostro desiderio? Fare la differenza nel campo motorsport per il nostro territorio.</p>
      <a href="/associazione/" class="type-mono link-line chi__link">Leggi la storia dell'associazione <span class="arrow-x" aria-hidden="true">→</span></a>
    </div>
    <div class="chi__n">
      <h3 class="type-h3">I numeri dei nostri eventi</h3>
      <StatBlock stats={numeri} columns={2} />
    </div>
  </section>

  <!-- NOTIZIE (fondo bianco) -->
  <section class="on-light" aria-labelledby="notizie">
    <div class="wrap section">
      <SectionHead id="notizie" title="Ultime notizie" intro="Comunicati, aggiornamenti sugli eventi e resoconti delle edizioni appena concluse." href="/news/" label="Leggi tutte le notizie" light />
      <div class="news-grid stagger">
        {news.map(n => <NewsCard {...n} light />)}
      </div>
    </div>
  </section>

  <!-- FOTO -->
  <div class="wrap section">
    <PhotoStrip full foto={fotoRecenti(10)} title="Foto degli ultimi eventi" intro="Una selezione dalle gallerie ufficiali di Polo Motor Show e Legnaro Motori." href="/foto-e-video/" credito="Foto: Inversione A U" id="foto-home" />
  </div>

  <!-- PARTNER -->
  <section class="hair" aria-labelledby="partner">
    <div class="wrap section partner">
      <SectionHead id="partner" title="I nostri partner" intro="Le aziende che sostengono i nostri eventi 2026" />
      <SponsorBlock sponsors={annuali} columns={6} mono={false} />
      <a href="/sponsor/diventa-sponsor/" class="partner__cta">
        <span class="partner__cta-t">
          <span class="type-mono text-meta">Stagione 2027</span>
          <h3 class="type-h3">Come diventare sponsor <span class="arrow-x" aria-hidden="true">→</span></h3>
        </span>
      </a>
      <p class="type-body-dark partner__p">Nel 2026 al Polo Motor Show ci hanno affiancato 23 sponsor ufficiali e 4 espositori, davanti a oltre 10.000 spettatori nelle due giornate di evento e al nostro pubblico online.</p>
    </div>
  </section>

  <!-- SOCIAL -->
  <SocialStrip post={social} title="Seguici sui nostri canali" intro="Una selezione dei post che raccontano gli eventi e il dietro le quinte. Li scegliamo noi, uno per uno." id="social-home" />

  <!-- CHIUSURA -->
  <CTABlock kicker="Inversione A U" title="Fai parte di Inversione A U" text="Piloti, volontari e sponsor, una grande famiglia in crescita, unita dal motorsport." image="/foto/polo_pubblico_sera.jpg">
    <a href="/associazione/#tesseramento" class="btn btn--primary">Diventa socio</a>
    <a href="/contatti/" class="btn btn--secondary">Scrivi all'associazione</a>
  </CTABlock>
</Base>

<style>
  /* hero */
  .hero{position:relative;height:86vh;min-height:520px;background:var(--nero);overflow:hidden;display:flex}
  .hero__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .hero__scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.7) 0%,rgba(0,0,0,.5) 40%,rgba(0,0,0,.15) 75%,rgba(0,0,0,0) 100%),linear-gradient(180deg,rgba(0,0,0,.1) 0%,rgba(0,0,0,.72) 100%)}
  .hero__in{position:relative;align-self:flex-end;width:100%;padding-bottom:var(--sp-8);display:flex;flex-direction:column;gap:16px;color:#fff}
  .hero__kicker{color:var(--grigio-200);letter-spacing:.08em}
  .hero__targa{width:min(400px,72vw);height:auto;margin-bottom:4px}
  .hero__h1{display:flex;flex-direction:column;gap:8px;text-wrap:balance}
  .hero__name{font-size:14px;letter-spacing:.16em;color:var(--grigio-200);text-transform:uppercase}
  .hero__sub{font-family:var(--font-display);font-stretch:125%;font-weight:900;text-transform:uppercase;letter-spacing:.01em;font-size:clamp(34px,7.6vw,84px);line-height:1.03}
  .hero__count{color:var(--grigio-200);font-size:14px}
  .hero__intro{max-width:52ch}
  .hero__cta{display:flex;gap:16px;flex-wrap:wrap;margin-top:8px}
  .hero__note{color:var(--grigio-200)}
  /* accesso rapido */
  .accesso{width:100%;border-top:1px solid var(--border-on-dark);border-bottom:1px solid var(--border-on-dark)}
  .accesso__grid{display:grid;grid-template-columns:minmax(0,1fr)}
  @media(min-width:640px){.accesso__grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
  @media(min-width:1180px){.accesso__grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
  .accesso__grid a{display:flex;flex-direction:column;gap:8px;padding:24px clamp(16px,3vw,28px);height:100%;text-decoration:none;border-right:1px solid var(--border-on-dark);border-bottom:1px solid var(--border-on-dark);transition:background-color var(--dur-fast) var(--ease-out);height:100%}
  @media(min-width:1180px){.accesso__grid a{border-bottom:0}.accesso__grid li:last-child a{border-right:0}}
  .accesso__grid a:hover,.accesso__grid a:focus-visible{background:var(--carbone)}
  .accesso__n{color:var(--rally-verde)}
  .accesso__t{color:#fff}
  .accesso__d{font-size:15px;color:var(--text-body-on-dark)}
  /* stagione */
  .stagione{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--grid-gutter);align-items:stretch}
  @media(min-width:768px){.stagione{grid-template-columns:repeat(4,minmax(0,1fr))}.stagione__rally{grid-column:span 4}.stagione__polo,.stagione__legnaro{grid-column:span 2}.stagione__next{grid-column:span 4}}
  @media(min-width:1024px){.stagione{grid-template-columns:repeat(3,minmax(0,1fr))}.stagione__rally{grid-column:span 2}.stagione__polo{grid-column:span 1}.stagione__legnaro{grid-column:span 1}.stagione__next{grid-column:span 2}}
  /* le card sono componenti: serve :global, altrimenti lo scope di pagina non le raggiunge e non si pareggiano */
  .stagione__rally>:global(*),.stagione__polo>:global(*),.stagione__legnaro>:global(*){height:100%}
  /* card rally larga 2 colonne: la foto non ha proporzione fissa, riempie lo spazio che resta
     così la card è alta esattamente come quella del Polo a fianco (scelta di Fabio, 19/8) */
  @media(min-width:1024px){.stagione__rally :global(.ec__media){aspect-ratio:auto}}
  /* testo e CTA entrambi in basso (scelta di Fabio, 19/8) */
  .stagione__next{background:var(--carbone);border:1px solid var(--border-on-dark);display:flex;flex-direction:column;justify-content:flex-end;gap:20px;padding:24px}
  @media(min-width:768px) and (max-width:1023px){.stagione__next{flex-direction:row;align-items:center;justify-content:space-between;flex-wrap:wrap}}
  .stagione__next-t{display:flex;flex-direction:column;gap:10px;min-width:0;max-width:60ch}
  .stagione__next>.btn{align-self:flex-start}
  .stagione__next-t h3{color:#fff}
  /* chi siamo */
  .chi{display:flex;flex-wrap:wrap;gap:var(--sp-6);align-items:flex-start;padding-bottom:var(--sp-10)}
  .chi__t{flex:1 1 380px;min-width:0}
  .chi__n{flex:1 1 420px;min-width:0}
  .chi__k{margin-bottom:16px}
  .chi h2{color:#fff;margin-bottom:12px}
  .chi__intro{margin-bottom:20px;max-width:560px}
  .chi__p{color:#DDD;margin-bottom:16px;max-width:560px}
  .chi__link{color:#fff;display:inline-block;margin-top:4px}
  .chi__n h3{color:#fff;margin-bottom:20px}
  /* notizie */
  .news-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:32px}
  /* partner */
  .partner{display:flex;flex-direction:column;gap:32px}
  .partner__cta{text-decoration:none;border:1px solid var(--border-on-dark);background:var(--carbone);padding:var(--sp-3) var(--sp-4);display:flex;justify-content:space-between;align-items:center;gap:var(--sp-3);flex-wrap:wrap;transition:border-color var(--dur-fast) var(--ease-out);color:#fff}
  .partner__cta:hover,.partner__cta:focus-visible{border-color:#fff}
  .partner__cta-t{display:flex;flex-direction:column;gap:6px;min-width:0}
  .partner__cta-d{max-width:40ch}
  .partner__p{max-width:640px}
</style>
