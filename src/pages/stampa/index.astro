---
/** Area stampa — accesso libero: accrediti, referente, comunicati, foto HR, testo di presentazione, media kit. */
import '../../styles/hub.css';
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/news';
const email = 'inversione.au3@gmail.com';
const comunicati = posts.filter(p => p.tipo === 'comunicato stampa').sort((a, b) => (a.iso < b.iso ? 1 : -1));
const BOILER = 'Inversione A U A.S.D. è un’associazione sportiva dilettantistica di Padova che organizza eventi motorsport sui Colli Euganei. Nasce come team drift nel 2017, organizza eventi dinamici dal 2022 e si costituisce in associazione nel 2023. Nel 2026 firma tre manifestazioni: Legnaro Motori il 15 marzo, il Polo Motor Show il 13 e 14 giugno e il 1° Rally Colli Euganei ACI Sport il 21 e 22 novembre, il primo rally sui Colli dopo più di trent’anni. Le ultime edizioni hanno superato i 15.000 spettatori, con circa 100 equipaggi in due giorni e oltre 300 auto esposte.';
const loghi = [
  { file: '/mediakit/logo-inversione-bianco.png', web: '/mediakit/web/logo-inversione-bianco.png', t: 'Logo Inversione A U', s: 'Versione per fondo scuro · PNG ↓', n: 'Vettoriale: PDF', dark: true },
  { file: '/mediakit/logo-inversione-nero.png', web: '/mediakit/web/logo-inversione-nero.png', t: 'Logo Inversione A U', s: 'Versione per fondo chiaro · PNG ↓', n: 'Vettoriale: PDF', dark: false },
  { file: '/mediakit/targa-rally-colli-euganei.svg', web: '/mediakit/web/targa-rally-colli-euganei.png', t: 'Targa 1° Rally Colli Euganei', s: 'Edizione 2026 · SVG ↓', n: 'Anche in PNG', dark: true },
  { file: '/mediakit/logo-polo-2026-bianco.svg', web: '/mediakit/web/logo-polo-2026-bianco.png', t: 'Logo Polo Motor Show 2026', s: 'Versione per fondo scuro · SVG ↓', n: 'Anche in PNG', dark: true },
  { file: '/mediakit/logo-polo-2026-nero.svg', web: '/mediakit/web/logo-polo-2026-nero.png', t: 'Logo Polo Motor Show 2026', s: 'Versione per fondo chiaro · SVG ↓', n: 'Anche in PNG', dark: false },
  { file: '/mediakit/logo-legnaro-2026-2.png', web: '/mediakit/web/logo-legnaro-2026-2.png', t: 'Logo Legnaro Motori 2026', s: 'Versione con la data · PNG ↓', n: 'Vettoriale: PDF', dark: true },
];
const altri = [
  ['Inversione A U · PDF', '/mediakit/logo-inversione-vettoriale.pdf'], ['Legnaro Motori · PDF', '/mediakit/logo-legnaro-2026-vettoriale.pdf'], ['Legnaro Motori · variante', '/mediakit/logo-legnaro-2026-1.png'],
  ['Targa rally · PNG', '/mediakit/targa-rally-colli-euganei.png'], ['Polo bianco · PNG', '/mediakit/logo-polo-2026-bianco.png'], ['Polo nero · PNG', '/mediakit/logo-polo-2026-nero.png'],
];
---
<Base title="Area stampa e accrediti | Inversione A U" description="Area stampa Inversione A U: comunicati, foto in alta risoluzione, testo di presentazione, loghi e brand book. Come richiedere l'accredito per il Rally Colli Euganei e gli altri eventi." active="" image="/img/social/stampa.jpg" imageAlt="Area stampa Inversione A U">
  <header class="wrap pg-head">
    <p class="type-mono text-meta">Area stampa · accesso libero, senza password</p>
    <h1 class="type-h1">Stampa: comunicati, foto e accrediti</h1>
    <p class="lead">Tutto quello che serve per raccontare i nostri eventi. Nessuna password: i materiali sono liberi.</p>
  </header>

  <section class="wrap section" aria-labelledby="due-h">
    <h2 id="due-h" class="type-h2 mb">Le due richieste più frequenti</h2>
    <div class="due stagger">
      <a href="/stampa/accrediti/" class="card card--top reveal due__a"><h3 class="type-h3">Richiedi l'accredito stampa</h3><p>Requisiti, scadenze, riprese con drone e ritiro della pettorina in sala stampa.</p><span class="type-mono due__l">Compila il modulo <span class="arrow-x" aria-hidden="true">→</span></span></a>
      <a href="#materiali" class="card card--top reveal due__a"><h3 class="type-h3">Scarica i materiali per la stampa</h3><p>Loghi vettoriali, foto selezionate, testo di presentazione e numeri chiave.</p><span class="type-mono due__l">Vai al download <span class="arrow-down" aria-hidden="true">↓</span></span></a>
    </div>
  </section>

  <section id="referente" class="wrap section ref" aria-labelledby="ref-h">
    <div>
      <h2 id="ref-h" class="type-h2">Chi contattare per la stampa</h2>
      <p class="type-body-dark p">Una persona sola, un indirizzo solo. Rispondiamo entro un giorno lavorativo.</p>
      <p class="ref__n">Ufficio stampa Inversione A U</p>
      <p class="type-body-dark p">Nei giorni di gara il referente è raggiungibile al telefono dal primo passaggio in prova speciale fino alla premiazione. Per le richieste che arrivano durante l'evento, il canale più rapido è il messaggio scritto.</p>
    </div>
    <ul class="ref__c"><li><a class="type-mono link-line" href={`mailto:${email}`}>{email}</a></li><li><a class="type-mono link-line" href="tel:+393489049212">+39 348 904 9212</a></li></ul>
  </section>

  <section id="comunicati" class="wrap section" aria-labelledby="cs-h">
    <h2 id="cs-h" class="type-h2">Comunicati stampa</h2>
    <p class="type-body-dark p">Il testo sulla pagina è pensato per essere copiato e incollato in redazione. Ogni comunicato è anche nelle news.</p>
    <ul class="cs">
      {comunicati.map((c, i) => (
        <li class="cs__i">
          <span class="type-mono k">CS {String(comunicati.length - i).padStart(2, '0')}</span>
          <a class="cs__t" href={`/news/${c.slug}/`}>{c.title}</a>
          <span class="type-mono text-meta"><time datetime={c.iso}>{c.date}</time></span>
          <a class="type-mono link-line cs__l" href={`/news/${c.slug}/`}>Leggi il comunicato <span class="arrow-x" aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section id="foto-hr" class="wrap section" aria-labelledby="hr-h">
    <h2 id="hr-h" class="type-h2">Foto in alta risoluzione per le redazioni</h2>
    <p class="type-body-dark p">Una cartella per ogni giornata di gara, pronta il giorno dopo entro le 12.</p>
    <p class="type-body-dark p">Le foto sono libere per uso editoriale. È obbligatorio il credit «Foto: Inversione A U» accanto all'immagine o nella didascalia. Per l'uso commerciale o pubblicitario serve la nostra autorizzazione scritta.</p>
    <p class="hint">Le cartelle restano online per dodici mesi · le gallerie web sono in <a href="/foto-e-video/">Foto e video</a></p>
  </section>

  <section id="presentazione" class="wrap section" aria-labelledby="pr-h">
    <h2 id="pr-h" class="type-h2">Testo di presentazione da copiare</h2>
    <p class="type-body-dark p">Le righe da inserire in coda all'articolo. Contengono i dati corretti e aggiornati.</p>
    <div class="card card--left boiler">
      <p data-boiler>{BOILER}</p>
      <div class="boiler__row"><button type="button" class="btn btn--secondary" data-copia>Copia il testo</button><span class="type-mono text-meta" aria-live="polite" data-copia-stato></span></div>
    </div>
  </section>

  <section id="materiali" class="wrap section" aria-labelledby="mk-h">
    <h2 id="mk-h" class="type-h2 mb">Loghi, targhe e cartella completa</h2>
    <div class="bb card card--left">
      <div><h3 class="type-h3">Brand book</h3><p>Il brand book contiene l'uso corretto del marchio: versioni, spazi di rispetto, colori e tipografia.</p><span class="hint">PDF · brand book Inversione A U</span></div>
      <a class="btn btn--primary" href="/mediakit/brand-book-inversione-a-u.pdf" download>Scarica il brand book ↓</a>
    </div>
    <ul class="mk stagger">
      {loghi.map(l => (
        <li class="reveal"><a class="mk__a" href={l.file} download>
          <span class:list={['mk__img', { 'mk__img--light': !l.dark }]}><img src={l.web} alt="" loading="lazy" decoding="async" /></span>
          <h3 class="type-h3">{l.t}</h3><span class="type-mono">{l.s}</span><span class="hint">{l.n}</span>
        </a></li>
      ))}
    </ul>
    <div class="alt">
      <div><h3 class="type-h3">Altri file del kit</h3><p class="type-body-dark">Le versioni vettoriali e la seconda variante del logo di Legnaro Motori.</p></div>
      <ul class="alt__l">{altri.map(([t, h]) => <li><a class="type-mono link-line" href={h} download>{t} ↓</a></li>)}</ul>
    </div>
    <p class="type-body-dark p">Non modificare le proporzioni dei loghi e non cambiare i colori. I loghi non vanno colorati, distorti né ricomposti.</p>
  </section>
</Base>
<script>
  const b = document.querySelector<HTMLButtonElement>('[data-copia]'), t = document.querySelector<HTMLElement>('[data-boiler]'), s = document.querySelector<HTMLElement>('[data-copia-stato]');
  b?.addEventListener('click', async () => {
    const txt = t?.textContent ?? '';
    try { await navigator.clipboard.writeText(txt); } catch { const ta = document.createElement('textarea'); ta.value = txt; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
    b.textContent = 'Copiato'; if (s) s.textContent = 'Testo copiato negli appunti';
    setTimeout(() => { b.textContent = 'Copia il testo'; if (s) s.textContent = ''; }, 3000);
  });
</script>
<style>
  .pg-head{padding-top:var(--sp-6);padding-bottom:var(--sp-2);display:flex;flex-direction:column;gap:12px}
  .pg-head h1{color:#fff}
  .lead{color:var(--text-body-on-dark);max-width:60ch;font-size:17px}
  h2{color:#fff}
  .mb{margin-bottom:var(--sp-4)}
  .p{max-width:70ch;margin-top:8px}
  .due{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--grid-gutter)}
  @media(min-width:768px){.due{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
  .due__a{text-decoration:none;color:#fff;transition:border-color var(--dur-fast) var(--ease-out)}
  .due__a:hover,.due__a:focus-visible{border-color:#fff}
  .due__l{color:#fff;margin-top:auto}
  .ref{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-5);align-items:start}
  @media(min-width:900px){.ref{grid-template-columns:minmax(0,1.4fr) minmax(0,1fr)}}
  .ref__n{color:#fff;font-weight:600;margin-top:16px}
  .ref__c{display:flex;flex-direction:column;gap:12px}
  .ref__c a{color:#fff}
  .cs{display:flex;flex-direction:column;border-top:1px solid var(--border-on-dark);margin-top:var(--sp-3)}
  .cs__i{display:grid;grid-template-columns:minmax(0,1fr);gap:6px;padding:16px 0;border-bottom:1px solid var(--border-on-dark)}
  @media(min-width:900px){.cs__i{grid-template-columns:70px 1fr 120px auto;gap:20px;align-items:center}}
  .k{color:#fff}
  .cs__t{color:#fff;font-weight:600;text-decoration:none}
  .cs__t:hover{text-decoration:underline;text-underline-offset:4px}
  .cs__l{color:#fff;white-space:nowrap}
  .hint a{color:#fff}
  .boiler{margin-top:var(--sp-3);max-width:80ch}
  .boiler p{color:#DDD}
  .boiler__row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .bb{flex-direction:row;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;margin-bottom:var(--sp-4)}
  .bb h3{color:#fff;margin-bottom:6px}
  .mk{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--grid-gutter)}
  @media(min-width:640px){.mk{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(min-width:1024px){.mk{grid-template-columns:repeat(3,minmax(0,1fr))}}
  .mk__a{display:flex;flex-direction:column;gap:8px;text-decoration:none;color:#fff;background:var(--carbone);border:1px solid var(--border-on-dark);padding:20px;transition:border-color var(--dur-fast) var(--ease-out);height:100%}
  .mk__a:hover,.mk__a:focus-visible{border-color:#fff}
  .mk__img{display:flex;align-items:center;justify-content:center;aspect-ratio:16/9;background:#000;padding:20px;margin-bottom:8px}
  .mk__img--light{background:#fff}
  .mk__img img{max-height:100%;width:auto;max-width:100%}
  .mk__a h3{font-size:18px}
  .mk__a .type-mono{color:var(--grigio-200)}
  .alt{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-4);margin-top:var(--sp-5);padding-top:var(--sp-4);border-top:1px solid var(--border-on-dark)}
  @media(min-width:900px){.alt{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
  .alt h3{color:#fff;margin-bottom:6px}
  .alt__l{display:flex;flex-direction:column;gap:10px}
  .alt__l a{color:#fff}
</style>
