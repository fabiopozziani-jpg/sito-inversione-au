---
/** Rally — Documenti di gara: Sportity, ultime pubblicazioni, albo (tabella per gruppi), stato vuoto. */
import '../../styles/hub.css';
import Base from '../../layouts/Base.astro';
import EventSubnav from '../../components/EventSubnav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { subnav, gruppiAlbo, fmtData, unMesePrima, domandeOnline, moduliIscrizionePdf } from '../../data/rally';
import { caricaRally } from '../../lib/contenuti';
const { rally, documenti } = await caricaRally();
const url = '/rally-colli-euganei/documenti/';

const list = documenti.map(d => ({ ...d, t: new Date(d.iso).getTime() })).sort((a, b) => b.t - a.t);
const now = Date.now();
const ref = Math.max(now, list[0]?.t ?? 0);
const NEW_MS = 3 * 24 * 3600 * 1000;
const docs = list.map(d => ({
  ...d,
  gruppo: d.gruppo ?? 'Regolamento e programma',
  nuovo: !d.superato && ref - d.t <= NEW_MS,
  revLine: d.revPrev && d.revPrevIso ? `Versione ${d.rev} · sostituisce la versione ${d.revPrev} del ${fmtData(d.revPrevIso)}` : '',
  superatoLine: d.superato ? `Superato dalla versione ${d.superatoDa}` : '',
}));
/** Dentro un gruppo l'albo si legge per numero (1.1, 1.2, 3.10…), non per data. */
const chiaveNum = (n: string) => String(n ?? '').split('.').map(x => Number(x) || 0);
const perNumero = (a: { num: string }, b: { num: string }) => {
  const A = chiaveNum(a.num), B = chiaveNum(b.num);
  for (let i = 0; i < Math.max(A.length, B.length); i++) { const d = (A[i] ?? 0) - (B[i] ?? 0); if (d) return d; }
  return 0;
};
const dopo = unMesePrima();
/** Dal 23 ottobre l'albo apre con un gruppo «Iscrizioni»: i tre moduli online, le due
 *  domande in PDF (3.8 e 3.9) e l'area riservata ACI. Le due righe PDF si SPOSTANO lì,
 *  quindi vanno tolte dal gruppo Modulistica per non comparire due volte. */
const docsIscrizione = dopo ? moduliIscrizionePdf.map(n => docs.find(d => d.num === n)).filter(Boolean) as typeof docs : [];
const numIscrizione = new Set(docsIscrizione.map(d => d.num));
const aciAreaRiservata = 'https://www.acisport.it/it/acisport/area-riservata/login';
const gruppi = gruppiAlbo.map(label => ({ label, docs: docs.filter(d => d.gruppo === label && !numIscrizione.has(d.num)).sort(perNumero) })).filter(g => g.docs.length);
const ultimi = list.filter(d => !d.superato).slice(0, 3);
const hasDocs = docs.length > 0;
---
<Base
  title="Documenti di gara Rally Colli Euganei | Inversione A U"
  description="Albo di gara del 1° Rally Colli Euganei: regolamento particolare, programma, tabella tempi, comunicazioni del direttore di gara e modulistica."
  active="rally" bodyClass="ctx-rally" image="/img/social/rally-colli-euganei.jpg" imageAlt="1° Rally Colli Euganei ACI Sport, 21–22 novembre 2026"
>
  <EventSubnav items={subnav()} current={url} bg="#006C7C" accent="#00BA89" label="Sezioni del Rally Colli Euganei" />
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Rally Colli Euganei', href: rally.base }, { label: 'Documenti di gara' }]} />

  <header class="wrap pg-head">
    <div class="pg-head__row">
      <div>
        <h1 class="type-h1">Documenti di gara e comunicazioni ufficiali</h1>
        <p class="lead" style="margin-top:12px">{unMesePrima() ? "Tutti i documenti ufficiali del rally, dal più recente. Vale sempre l'ultima versione." : "Tutti i documenti ufficiali del 1° Rally Colli Euganei, dal più recente. Vale sempre l'ultima versione."}</p>
        <p class="type-mono pg-head__reg">{hasDocs
          ? (unMesePrima() ? 'Programma, tabella tempi, modulistica e allegati pubblicati · regolamento particolare in fase di approvazione' : 'Modulistica e allegati già pubblicati · regolamento particolare in fase di approvazione · programma e tabella tempi in arrivo')
          : 'Tutti i documenti di gara sono in arrivo'}</p>
      </div>
      {hasDocs && <p class="type-mono k-meta">Aggiornato al <time datetime={list[0].iso.slice(0, 10)}>{fmtData(list[0].iso)}</time></p>}
    </div>
  </header>

  <!-- SPORTITY -->
  <section id="sportity" class="wrap sp" aria-labelledby="sp-h">
    <div class="sp__box reveal">
      <div class="sp__t">
        <span class="type-mono k-ev">Comunicazioni del direttore di gara</span>
        <h2 id="sp-h" class="type-h3">Ricevi gli avvisi di gara sul telefono</h2>
        <p>Le comunicazioni ufficiali arrivano come notifica sul telefono, tramite l'app Sportity.</p>
        <p>{unMesePrima() ? "È l'app usata dai rally di tutto il mondo: gratuita, senza registrazione. Basta inserire una volta la password del canale." : "Sportity è l'app usata dai rally di tutto il mondo per l'albo di gara. È gratuita, non chiede registrazione e non serve creare un account. Basta inserire una volta la password del canale del rally."}</p>
        <p>{unMesePrima() ? "Sono le stesse comunicazioni dell'albo qui sotto: se non installi l'app, trovi tutto in questa pagina." : "Le comunicazioni pubblicate su Sportity sono le stesse dell'albo di gara qui sotto. Se non riesci a installare l'app, trovi tutto in questa pagina."}</p>
        <p class="sp__uff">Sportity è il canale ufficiale con cui l'organizzazione del rally comunica e pubblica i documenti di gara. In caso di differenza fra le due versioni vale quella pubblicata su Sportity.</p>
      </div>
      <div class="sp__steps">
        <ol class="sp__ol">
          <li>{unMesePrima() ? "Scarica l'app Sportity dallo store del tuo telefono." : "Scarica l'app Sportity dallo store del tuo telefono. Su iPhone si chiama App Store, su Android si chiama Play Store."}</li>
          <li>{unMesePrima() ? 'Aprila e tocca il + in alto a destra.' : "Apri l'app. Tocca il segno + in alto a destra."}</li>
          <li>{unMesePrima() ? 'Inserisci la password del canale, in maiuscolo e senza spazi:' : 'Scrivi la password del canale, in maiuscolo, senza spazi:'}
            <span class:list={['type-mono', 'sp__pw', { 'sp__pw--attesa': !rally.sportity.password }]}>{rally.sportity.password || 'In arrivo'}</span>
            {!rally.sportity.password && <span class="hint">{unMesePrima() ? 'La pubblichiamo qui appena il canale è aperto.' : 'La password del canale è in arrivo: la pubblichiamo qui appena il canale è aperto.'}</span>}
          </li>
          {unMesePrima()
            ? <li>Tocca Aggiungi e lascia attive le notifiche: ogni comunicazione del direttore di gara ti arriva sul telefono.</li>
            : <Fragment><li>Tocca Aggiungi. Il canale del 1° Rally Colli Euganei compare nell'elenco.</li>
              <li>Lascia attive le notifiche. Ogni nuova comunicazione del direttore di gara ti arriva sul telefono.</li></Fragment>}
        </ol>
        <div class="sp__store">
          <a class="link-box" href={rally.sportity.ios} target="_blank" rel="noopener">Scarica l'app per iPhone ↗</a>
          <a class="link-box" href={rally.sportity.android} target="_blank" rel="noopener">Scarica l'app per Android ↗</a>
        </div>
        <span class="hint">{unMesePrima() ? 'Si aprono in una nuova pagina' : 'I due pulsanti aprono lo store in una nuova pagina'}</span>
        {rally.sportity.web && (
          <div class="sp__web">
            <a class="link-box" href={rally.sportity.web} target="_blank" rel="noopener">Apri il canale dal browser&nbsp;↗</a>
            <span class="hint">Stesse comunicazioni, anche da computer, senza installare nulla. Le notifiche però arrivano solo con l'app.</span>
          </div>
        )}
      </div>
    </div>
  </section>

  {hasDocs ? (
    <>
      {!dopo && (
        <section id="aggiornamenti" class="wrap section ult" aria-labelledby="ult-h">
        <h2 id="ult-h" class="type-h2">Pubblicati negli ultimi giorni</h2>
        <p class="type-body-dark ult__intro">Le tre pubblicazioni più recenti. Se non vedi nulla di nuovo, l'albo non è cambiato.</p>
        <div class="ult__grid stagger">
          {ultimi.map(u => (
            <a class="card card--top reveal ult__a" href={u.href} target="_blank" rel="noopener">
              <span class="type-mono k-meta"><time datetime={u.iso}>{fmtData(u.iso)}</time></span>
              <span class="ult__t">{u.title}</span>
              <span class="type-mono k-ev">{u.revPrev ? `Revisione ${u.rev}` : 'Nuova pubblicazione'}</span>
            </a>
          ))}
        </div>
      </section>
      )}

      <section id="albo" class="wrap section albo" aria-labelledby="albo-h">
        <h2 id="albo-h" class="type-h2">Albo di gara</h2>
        <p class="type-body-dark albo__intro">Tutti i documenti pubblicati, dal più recente. Ogni riga si apre o si scarica.</p>
        <dl class="albo__leg">
          <div><dt class="type-mono">Versione</dt><dd>{unMesePrima() ? "— quante volte il documento è stato aggiornato. Vale sempre l'ultima." : "— un documento può essere corretto e ripubblicato. Il numero di versione dice quante volte è stato aggiornato. Vale sempre l'ultima."}</dd></div>
          <div><dt class="type-mono">Nuovo</dt><dd>— pubblicato negli ultimi 3 giorni.</dd></div>
          <div><dt class="type-mono">Testo barrato</dt><dd>{unMesePrima() ? '— superato da una versione più recente. Resta in elenco ma non è più valido.' : '— documento superato da una versione più recente. Resta in elenco per consultazione, ma non è più valido.'}</dd></div>
        </dl>
        <div class="tbl-wrap">
          <table class="tbl albo__tbl tbl--cards">
            <caption class="type-mono">Albo di gara — documenti pubblicati, dal più recente</caption>
            <thead><tr><th scope="col">Documento</th><th scope="col">Versione</th><th scope="col">Pubblicato il</th><th scope="col">File</th></tr></thead>
            <tbody>
              {dopo && (
                <>
                  <tr class="gruppo"><th colspan="4" scope="colgroup">Iscrizioni</th></tr>
                  {domandeOnline.map(m => (
                    <tr>
                      <td><div class="albo__doc"><span class="doc-title">{m.nome}</span></div><div class="hint">{m.nota}</div></td>
                      <td class="type-mono" data-label="Versione">—</td>
                      <td class="type-mono" data-label="Pubblicato il">—</td>
                      <td data-label="File"><div class="albo__file"><div class="albo__links"><a class="type-mono" href={m.url} target="_blank" rel="noopener">Apri ↗</a></div><span class="hint">Modulo online</span></div></td>
                    </tr>
                  ))}
                  {docsIscrizione.map(d => (
                    <tr class:list={{ superato: d.superato }}>
                      <td><div class="albo__doc"><span class="type-mono k-ev">{d.num}</span><span class="doc-title">{d.title}</span>{d.nuovo && <span class="pill pill--pieno">Nuovo</span>}</div></td>
                      <td class="type-mono" data-label="Versione">{d.rev ?? '—'}</td>
                      <td class="type-mono" data-label="Pubblicato il"><time datetime={d.iso}>{fmtData(d.iso)}</time></td>
                      <td data-label="File"><div class="albo__file"><div class="albo__links"><a class="type-mono" href={d.href} target="_blank" rel="noopener">Apri ↗</a><a class="type-mono" href={d.href} download>Scarica ↓</a></div><span class="hint">{d.file}</span></div></td>
                    </tr>
                  ))}
                  <tr>
                    <td><div class="albo__doc"><span class="doc-title">Area riservata ACI Sport</span></div><div class="hint">Registrazione e licenze</div></td>
                    <td class="type-mono" data-label="Versione">—</td>
                    <td class="type-mono" data-label="Pubblicato il">—</td>
                    <td data-label="File"><div class="albo__file"><div class="albo__links"><a class="type-mono" href={aciAreaRiservata} target="_blank" rel="noopener">Apri ↗</a></div><span class="hint">Si apre in una nuova pagina</span></div></td>
                  </tr>
                </>
              )}
              {gruppi.map(g => (
                <>
                  <tr class="gruppo"><th colspan="4" scope="colgroup">{g.label}</th></tr>
                  {g.docs.map(d => (
                    <tr class:list={{ superato: d.superato }}>
                      <td>
                        <div class="albo__doc"><span class="type-mono k-ev">{d.num}</span><span class="doc-title">{d.title}</span>{d.nuovo && <span class="pill pill--pieno">Nuovo</span>}{d.superato && <span class="pill">Superato</span>}</div>
                        {d.revLine && <div class="hint">{d.revLine}</div>}
                        {d.superatoLine && <div class="hint">{d.superatoLine}</div>}
                      </td>
                      <td class="type-mono" data-label="Versione">{d.rev ?? '—'}</td>
                      <td class="type-mono" data-label="Pubblicato il"><time datetime={d.iso}>{fmtData(d.iso)}</time></td>
                      <td data-label="File">
                        <div class="albo__file">
                          <div class="albo__links"><a class="type-mono" href={d.href} target="_blank" rel="noopener">Apri ↗</a><a class="type-mono" href={d.href} download>Scarica ↓</a></div>
                          <span class="hint">{d.file}</span>
                        </div>
                      </td>
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
        <p class="hint">{unMesePrima() ? '«Apri» lo mostra in una nuova pagina · «Scarica» lo salva sul dispositivo' : '«Apri» mostra il documento in una nuova pagina · «Scarica» lo salva sul dispositivo'}</p>
        <p class="type-body-dark">{unMesePrima() ? 'Problemi con un documento? Scrivi a ' : 'Per assistenza sui documenti: '}<a class="albo__mail" href={`mailto:${rally.email}`}>{rally.email}</a></p>
      </section>
    </>
  ) : (
    <section class="wrap section" aria-label="Albo di gara">
      <div class="card card--left vuoto reveal">
        <span class="type-mono k-ev">Albo di gara</span>
        <p class="type-h3 vuoto__t" role="status">Nessun documento pubblicato</p>
        <p>Il regolamento particolare di gara è in fase di approvazione; il programma e la tabella distanze e tempi sono in arrivo. Li pubblichiamo qui con data, ora e numero di revisione. Le comunicazioni del direttore di gara arrivano anche su Sportity.</p>
        <a class="type-mono link-line vuoto__a" href="#sportity">Attiva le notifiche su Sportity <span class="arrow-x" aria-hidden="true">→</span></a>
      </div>
    </section>
  )}
</Base>

<style>
  .sp{padding-bottom:var(--sp-4)}
  .sp__box{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-5);background:var(--carbone);border:1px solid var(--border-on-dark);border-top:var(--border-accent) solid var(--ev);padding:var(--sp-5)}
  @media(min-width:900px){.sp__box{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
  .sp__t{display:flex;flex-direction:column;gap:12px}
  .sp__t h2{color:#fff}
  .sp__t p{color:var(--text-body-on-dark)}
  .sp__steps{display:flex;flex-direction:column;gap:16px}
  .sp__ol{list-style:decimal;padding-left:22px;display:flex;flex-direction:column;gap:12px;color:#DDD}
  .sp__ol li::marker{font-family:var(--font-mono);color:var(--ev)}
  .sp__pw{display:block;width:fit-content;margin-top:10px;background:var(--bianco);border:1px solid var(--bianco);color:var(--nero);padding:10px 18px;font-size:18px;font-weight:600;letter-spacing:.16em;text-transform:uppercase}
  .sp__pw--attesa{letter-spacing:.1em;color:var(--nero);opacity:.92}
  .pg-head__reg{color:var(--ev);letter-spacing:.06em;margin-top:12px}
  .sp__store{display:flex;gap:12px;flex-wrap:wrap}
  .sp__uff{color:#fff;border-left:var(--border-accent) solid var(--ev);padding-left:14px}
  .sp__web{display:flex;flex-direction:column;gap:6px;align-items:flex-start;margin-top:4px}
  /* ultimi */
  .ult h2{color:#fff;margin-bottom:8px}
  .ult__intro{max-width:56ch;margin-bottom:var(--sp-4)}
  .ult__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:var(--grid-gutter)}
  .ult__a{text-decoration:none;color:#fff;transition:border-color var(--dur-fast) var(--ease-out)}
  .ult__a:hover,.ult__a:focus-visible{border-color:#fff}
  .ult__t{font-weight:600;color:#fff;flex:1}
  /* albo */
  .albo{display:flex;flex-direction:column;gap:16px}
  .albo h2{color:#fff}
  .albo__intro{max-width:56ch;margin-top:-8px}
  .albo__leg{display:flex;flex-direction:column;gap:6px;max-width:80ch;margin-bottom:8px}
  .albo__leg div{display:flex;gap:8px;flex-wrap:wrap}
  .albo__leg dt{color:#fff}
  .albo__leg dd{margin:0;color:var(--text-body-on-dark)}
  .albo__doc{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .doc-title{color:#fff;font-weight:600}
  .albo__file{display:flex;flex-direction:column;gap:6px}
  .albo__links{display:flex;gap:16px}
  .albo__links a{color:#fff;text-decoration:none;border-bottom:1px solid var(--grigio-500)}
  .albo__links a:hover{border-bottom-color:#fff}
  .albo__mail{color:#fff}
  /* vuoto */
  .vuoto{gap:12px}
  .vuoto__t{color:#fff}
  .vuoto__a{color:#fff;align-self:flex-start}
</style>
