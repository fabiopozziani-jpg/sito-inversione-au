---
/** Rally — Spettatori: programma, dove guardare, sicurezza, come arrivare, chiusura. */
import '../../styles/hub.css';
import Base from '../../layouts/Base.astro';
import EventSubnav from '../../components/EventSubnav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTABlock from '../../components/CTABlock.astro';
import { subnav, consentito, vietato } from '../../data/rally';
import { caricaRally } from '../../lib/contenuti';
import { rallyImg, RALLY_IMG } from '../../data/rallyImmagini';
import { srcsetFill } from '../../data/media';
const heroSpett = rallyImg(RALLY_IMG.heroSpettatori, 1920, 1080);
const { rally, programma } = await caricaRally();
const url = '/rally-colli-euganei/spettatori/';
---
<Base
  title="Spettatori — Rally Colli Euganei 2026 | Inversione A U"
  description="Come vedere il 1° Rally Colli Euganei il 21 e 22 novembre 2026: programma, dove guardare la gara, regole di sicurezza e come arrivare sui Colli."
  active="rally" bodyClass="ctx-rally" image="/img/social/rally-colli-euganei.jpg" imageAlt="1° Rally Colli Euganei ACI Sport, 21–22 novembre 2026"
>
  <EventSubnav items={subnav} current={url} bg="#006C7C" accent="#00BA89" label="Sezioni del Rally Colli Euganei" />
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Rally Colli Euganei', href: rally.base }, { label: 'Spettatori' }]} />

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-h1">
    <img class="hero__img" src={heroSpett} srcset={srcsetFill(heroSpett) || undefined} sizes="100vw" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="wrap hero__in">
      <p class="type-mono hero__kicker">{rally.dataLabel} · Colli Euganei</p>
      <h1 id="hero-h1" class="type-h1">Come vedere il 1° Rally Colli Euganei</h1>
      <p class="hero__intro">Ingresso libero. Programma, regole di sicurezza e come arrivare sui Colli.</p>
      <div><a href="/rally-colli-euganei/percorso/" class="btn btn--ev">Vedi percorso e prove speciali</a></div>
    </div>
  </section>

  <!-- PROGRAMMA -->
  <section id="programma" class="wrap section prog" aria-labelledby="prog-h">
    <h2 id="prog-h" class="type-h2">Programma e orari</h2>
    <p class="type-body-dark prog__intro">Le due giornate di gara. Gli orari mancanti vengono pubblicati appena confermati.</p>
    {programma.map(g => (
      <div class="prog__giorno reveal">
        <h3 class="type-h3 prog__g">{g.titolo}</h3>
        <ol class="prog__voci">
          {g.voci.map(v => (
            <li class="prog__riga">
              <div class="prog__ora"><span class="type-mono k-ev">{v.ora}</span>{v.prima && <span class="hint">{v.prima}</span>}</div>
              <div class="prog__t"><span class="prog__titolo">{v.titolo}</span><span class="type-body-dark">{v.nota}</span></div>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

  <!-- ZONE PUBBLICO -->
  <section id="zone-pubblico" class="wrap zone" aria-labelledby="zone-h">
    <h2 id="zone-h" class="type-h2">Dove guardare la gara</h2>
    <p class="type-body-dark zone__p">Le zone da cui si assiste al rally sono aree scelte dall'organizzazione, delimitate e presidiate dai commissari: buona visuale, accesso a piedi e un punto dove lasciare l'auto.</p>
    <p class="type-body-dark zone__p">Le prove speciali, i punti di accesso e le coordinate per raggiungerli vengono pubblicati sulla pagina del percorso, prova per prova, appena il tracciato è definito.</p>
    <a class="link-box zone__cta" href="/rally-colli-euganei/percorso/">Vai a percorso e prove speciali <span class="arrow-x" aria-hidden="true">→</span></a>
  </section>

  <!-- SICUREZZA -->
  <section id="sicurezza" class="sic" aria-labelledby="sic-h">
    <div class="wrap section">
      <h2 id="sic-h" class="type-h2">Sicurezza lungo il percorso</h2>
      <p class="type-body-dark sic__intro">Un rally si corre su strade chiuse al traffico. Queste regole valgono per tutti, sempre.</p>
      <div class="sic__grid stagger">
        <div class="card card--top reveal">
          <div class="sic__head">
            <span class="sic__ico sic__ico--ok" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><polyline points="20 6 9 17 4 12"/></svg></span>
            <h3 class="type-h3">Che cosa è consentito</h3>
          </div>
          <ul class="sic__list">{consentito.map(c => <li><span class="type-mono k-ev">Sì</span><span>{c}</span></li>)}</ul>
        </div>
        <div class="card sic__no reveal">
          <div class="sic__head">
            <span class="sic__ico sic__ico--no" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
            <h3 class="type-h3">Che cosa è vietato</h3>
          </div>
          <ul class="sic__list">{vietato.map(v => <li><span class="type-mono sic__noL">No</span><span>{v}</span></li>)}</ul>
        </div>
      </div>
      <div class="sic__avv">
        <p>La presenza lungo il percorso avviene a proprio rischio. Chi assiste alla gara è tenuto a rispettare le indicazioni dei commissari di percorso e delle forze dell'ordine, e le prescrizioni dell'ordinanza comunale di chiusura delle strade. Chi non rispetta queste indicazioni viene allontanato dalla zona.</p>
        <p>Le strade chiudono un'ora prima del passaggio della prima vettura e riaprono solo dopo il passaggio della vettura scopa, l'ultima del rally. Prima di quel momento non si attraversa e non si sposta l'auto.</p>
      </div>
      <div class="sic__prima">
        <h3 class="type-h3">Prima di partire</h3>
        <ul class="lista-ev">
          <li>Vestiti pesanti: a novembre sui Colli fa freddo e si sta fermi per ore.</li>
          <li>Scarpe chiuse e impermeabili: prati e scarpate sono quasi sempre bagnati.</li>
          <li>Porta contanti: in alcune zone il telefono prende poco.</li>
          <li>Il rally si corre con qualsiasi tempo, anche con la pioggia.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- COME ARRIVARE (bianco) -->
  <section class="on-light" aria-labelledby="arr-h">
    <div class="wrap section arr">
      <h2 id="arr-h" class="type-h2">Come arrivare</h2>
      <div class="arr__grid stagger">
        <div class="arr__col reveal"><span class="type-mono arr__k">In auto</span><p>Autostrada A13, uscita Terme Euganee, poi direzione Colli Euganei.</p></div>
        <div class="arr__col reveal"><span class="type-mono arr__k">In treno</span><p>Stazione di Terme Euganee — Abano Montegrotto, oppure Padova. Dalla stazione ai punti di gara serve un'auto: il trasporto pubblico non arriva alle prove speciali.</p></div>
        <div class="arr__col reveal"><span class="type-mono arr__k">Coordinate delle prove</span><p>I punti da cui si raggiungono le prove speciali vengono pubblicati sulla <a href="/rally-colli-euganei/percorso/">pagina del percorso</a>, insieme al tracciato.</p></div>
      </div>
    </div>
  </section>


  <!-- DOVE DORMIRE E MANGIARE (bianco) -->
  <section id="dormire" class="on-light dorm" aria-labelledby="dorm-h">
    <div class="wrap section">
      <h2 id="dorm-h" class="type-h2">Dove dormire e mangiare</h2>
      <p class="dorm__p">Il rally si corre a fine novembre sui Colli Euganei, a venti minuti da Padova. Se arrivi da fuori regione, queste sono le zone più comode. Non segnaliamo strutture singole: qui sotto trovi i canali ufficiali del territorio, sempre aggiornati.</p>
      <div class="arr__grid stagger">
        <div class="arr__col reveal">
          <span class="type-mono arr__k">Terme di Abano e Montegrotto</span>
          <p>La zona con più posti letto, a pochi chilometri dai Colli. Gli alberghi termali restano aperti anche fuori stagione.</p>
          <a class="type-mono dorm__l" href="https://www.visitabanomontegrotto.com/" target="_blank" rel="noopener">Sito ufficiale del territorio termale ↗</a>
        </div>
        <div class="arr__col reveal">
          <span class="type-mono arr__k">Nei paesi dei Colli</span>
          <p>Agriturismi, B&amp;B e cantine con ospitalità nei comuni attraversati dalla gara. Sono strutture piccole: a novembre conviene prenotare con qualche settimana di anticipo.</p>
          <a class="type-mono dorm__l" href="https://www.stradadelvinocollieuganei.it/" target="_blank" rel="noopener">Strada del Vino Colli Euganei ↗</a>
        </div>
        <div class="arr__col reveal">
          <span class="type-mono arr__k">Mangiare il giorno della gara</span>
          <p>Il rally attraversa i centri dei Colli: bar, trattorie e ristoranti dei paesi restano aperti per tutta la durata della gara. Nelle zone pubblico non c'è ristoro organizzato: porta acqua e qualcosa da mangiare, soprattutto per le prove del mattino.</p>
        </div>
      </div>
    </div>
  </section>

  <CTABlock kicker={rally.dataLabel} title="L'ingresso è libero" text="Non serve un biglietto. Scegli dove metterti lungo il percorso, arriva presto e resta dietro le protezioni.">
    <a href="/rally-colli-euganei/percorso/" class="btn btn--ev">Scegli dove andare lungo il percorso</a>
  </CTABlock>
</Base>

<style>
  .hero{position:relative;height:60vh;min-height:420px;background:var(--nero);overflow:hidden;display:flex}
  .hero__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .hero__scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.72) 0%,rgba(0,0,0,.52) 42%,rgba(0,0,0,.15) 78%,rgba(0,0,0,0) 100%),linear-gradient(180deg,rgba(0,0,0,.25) 0%,rgba(0,0,0,.75) 100%)}
  .hero__in{position:relative;align-self:flex-end;width:100%;padding-bottom:var(--sp-6);display:flex;flex-direction:column;gap:14px;color:#fff}
  .hero__kicker{color:var(--grigio-200)}
  .hero h1{color:#fff;max-width:18ch;text-wrap:balance}
  .hero__intro{max-width:52ch;color:#EEE}
  /* programma */
  .prog h2{color:#fff;margin-bottom:8px}
  .prog__intro{max-width:60ch;margin-bottom:var(--sp-5)}
  .prog__giorno{margin-bottom:var(--sp-5)}
  .prog__g{color:#fff;display:inline-block;padding-bottom:8px;border-bottom:var(--border-accent) solid var(--ev);margin-bottom:12px}
  .prog__riga{display:grid;grid-template-columns:minmax(0,1fr);gap:6px;padding:14px 0;border-top:1px solid var(--border-on-dark)}
  @media(min-width:640px){.prog__riga{grid-template-columns:190px 1fr;gap:24px}}
  .prog__ora,.prog__t{display:flex;flex-direction:column;gap:4px;min-width:0}
  .prog__titolo{font-weight:600;color:#fff}
  /* zone */
  .zone{padding-bottom:var(--sp-8)}
  .zone h2{color:#fff;margin-bottom:8px}
  .zone__p{max-width:70ch}
  .zone__cta{display:inline-flex;margin-top:var(--sp-3)}
  /* sicurezza */
  .sic{border-top:1px solid var(--border-on-dark);border-bottom:1px solid var(--border-on-dark);background:#0A0A0A}
  .sic h2{color:#fff;margin-bottom:8px}
  .sic__intro{max-width:70ch;margin-bottom:var(--sp-5)}
  .sic__grid{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--grid-gutter)}
  @media(min-width:900px){.sic__grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
  .sic__no{border-top:var(--border-accent) solid var(--alert-rosso)}
  .sic__head{display:flex;align-items:center;gap:12px}
  .sic__ico{flex:none;width:32px;height:32px;display:flex;align-items:center;justify-content:center}
  .sic__ico--ok{background:var(--ev);color:var(--nero)} .sic__ico--no{background:var(--alert-rosso);color:#fff}
  .sic__list{display:flex;flex-direction:column;gap:10px}
  .sic__list li{display:flex;gap:12px;align-items:flex-start;color:#DDD}
  .sic__list li>span:first-child{flex:none;width:28px;padding-top:3px}
  .sic__noL{color:var(--alert-rosso-chiaro)}
  .sic__avv{margin-top:var(--sp-5);max-width:80ch;border-left:var(--border-accent) solid var(--alert-rosso);padding-left:var(--sp-3);display:flex;flex-direction:column;gap:12px}
  .sic__avv p{color:#fff;font-size:15px}
  .sic__prima{margin-top:var(--sp-5);max-width:70ch;display:flex;flex-direction:column;gap:12px}
  .sic__prima h3{color:#fff}
  /* arrivare */
  .arr h2{margin-bottom:32px}
  .arr__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:var(--sp-4)}
  .arr__col{border-top:2px solid var(--nero);padding-top:16px}
  .arr__k{color:var(--rally-teal-scuro);display:block;margin-bottom:8px}
  .arr__col p{color:var(--text-secondary)}
  .arr__col p a{color:var(--nero);text-decoration:underline;text-underline-offset:3px}
  /* dormire e mangiare */
  .dorm{border-top:1px solid var(--border-divider)}
  .dorm h2{margin-bottom:16px}
  .dorm__p{color:var(--text-secondary);max-width:72ch;margin-bottom:var(--sp-4)}
  .dorm__l{display:inline-block;margin-top:12px;color:var(--nero);border-bottom:1px solid rgba(0,0,0,.25);padding-bottom:2px;transition:border-color var(--dur-fast) var(--ease-out)}
  .dorm__l:hover,.dorm__l:focus-visible{border-color:var(--nero)}
</style>
