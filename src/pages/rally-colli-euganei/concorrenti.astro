---
/** Rally — Concorrenti: iscrizioni (3 stati), licenze, scadenze, albo, elenco iscritti con filtro, classifiche live. */
import '../../styles/hub.css';
import Base from '../../layouts/Base.astro';
import EventSubnav from '../../components/EventSubnav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { subnav, classi, schedaGara, documentiRapidi } from '../../data/rally';
import { caricaRally } from '../../lib/contenuti';
const { rally, scadenze, iscritti, iscrittiAggiornatoAl, iscrittiPdf } = await caricaRally();
const url = '/rally-colli-euganei/concorrenti/';
const stato = rally.statoIscrizioni;
const isc = {
  'non-aperte': { kicker: 'Iscrizioni non ancora aperte', titolo: 'Le iscrizioni non sono ancora aperte', testo: `L'apertura è prevista ${rally.aperturaPrevista}. Lasciaci la tua email: ti scriviamo il giorno stesso in cui le iscrizioni aprono.` },
  'aperte': { kicker: 'Iscrizioni aperte', titolo: `Iscrizioni aperte fino al ${rally.chiusuraIscrizioni}`, testo: 'La domanda di iscrizione si compila sul portale ACI Sport. Tieni a portata di mano licenza, dati della vettura e dati del navigatore.' },
  'chiuse': { kicker: 'Iscrizioni chiuse', titolo: 'Iscrizioni chiuse', testo: `Le iscrizioni si sono chiuse il ${rally.chiusuraIscrizioni}. Gli equipaggi ammessi sono nell'elenco iscritti qui sotto.` },
}[stato];
const haIscritti = iscritti.length > 0;
---
<Base
  title="Iscrizioni Rally Colli Euganei 2026 | Inversione A U"
  description="Come iscriversi al 1° Rally Colli Euganei ACI Sport: licenze richieste, scadenze, modulo di iscrizione ed elenco degli equipaggi ammessi."
  active="rally" bodyClass="ctx-rally" image="/img/social/rally-colli-euganei.jpg" imageAlt="1° Rally Colli Euganei ACI Sport, 21–22 novembre 2026"
>
  <EventSubnav items={subnav} current={url} bg="#006C7C" accent="#00BA89" label="Sezioni del Rally Colli Euganei" />
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Rally Colli Euganei', href: rally.base }, { label: 'Concorrenti' }]} />

  <header class="wrap pg-head">
    <h1 class="type-h1">Concorrenti: iscrizione al Rally Colli Euganei</h1>
    <p class="lead">Come iscriversi, quali licenze servono, quali documenti scaricare e chi è ammesso alla partenza.</p>
  </header>

  <div class="wrap">
    <div class="card card--rosso avviso" role="note">
      <span class="type-mono avviso__k">Elenco provvisorio</span>
      <p class="avviso__p">Le informazioni di questa pagina non sono ancora definitive. Fanno fede il Regolamento Particolare di Gara e le disposizioni ACI Sport, che pubblichiamo nell'albo di gara. Verifica l'ultima versione prima di iscriverti.</p>
      <span class="hint">Ultima revisione · 28 AGO 2026</span>
    </div>
  </div>

  <!-- ISCRIZIONI -->
  <section id="iscrizioni" class="wrap section isc" aria-labelledby="isc-h">
    <h2 id="isc-h" class="type-h2">Iscrizioni e licenze</h2>
    <p class="type-body-dark isc__intro">Stato delle iscrizioni, licenza e date da tenere sotto controllo.</p>
    <div class="isc__grid">
      <div class="isc__col">
        <div class="card card--top reveal">
          <span class="type-mono k-ev">{isc.kicker}</span>
          <h3 class="type-h3">{isc.titolo}</h3>
          <p>{isc.testo}</p>
          {stato === 'non-aperte' && (
            <form class="avviso-form" data-mailform data-modulo="avvisami" data-to={rally.email} data-subject="Avvisami all'apertura delle iscrizioni · Rally Colli Euganei" novalidate>
              <input type="hidden" name="evento" value="Rally Colli Euganei 2026" />
              <div class="avviso-form__row">
                <label class="field"><span>La tua email</span><input type="email" name="email" placeholder="nome@email.it" autocomplete="email" required /></label>
                <button type="submit" class="btn btn--ev">Avvisami all'apertura</button>
              </div>
              <span class="hint">Usiamo l'indirizzo solo per questo avviso · <a href="/privacy/">informativa privacy</a></span>
              <p class="form-msg" role="status" aria-live="polite"></p>
            </form>
          )}
          {stato === 'aperte' && (
            <div class="isc__cta">
              <a href={rally.moduloUrl} target="_blank" rel="noopener" class="btn btn--ev">Compila la domanda di iscrizione ↗</a>
              <span class="hint">Si apre in una nuova pagina, sul sito ACI Sport</span>
              <p>Dopo l'invio riceverai la conferma dalla segreteria.</p>
            </div>
          )}
          {stato === 'chiuse' && <a href="#elenco-iscritti" class="btn btn--secondary">Vai all'elenco iscritti</a>}
        </div>
        <div class="req">
          <div class="req__head"><h3 class="type-h3">Licenza</h3></div>
          <p class="type-body-dark">Verifica la validità della propria licenza per questo evento sul sito ACI Sport.</p>
          <a class="link-box" href="https://www.acisport.it/it/acisport" target="_blank" rel="noopener">Vai al sito ACI Sport ↗</a>
          <span class="hint">Si apre in una nuova pagina · le licenze ammesse sono indicate nel Regolamento Particolare di Gara</span>
          <p class="hint">In caso di dubbio scrivi a <a href={`mailto:${rally.email}`}>{rally.email}</a></p>
        </div>
      </div>
      <div class="isc__col">
        <h3 class="type-h3">Date da segnare</h3>
        <div class="tbl-wrap">
          <table class="tbl tbl--scad tbl--cards">
            <thead><tr><th scope="col">Fase</th><th scope="col">Data</th><th scope="col">Ora</th></tr></thead>
            <tbody>{scadenze.map(s => <tr><th scope="row">{s.fase}</th><td data-label="Data">{s.data}</td><td class="tabular" data-label="Ora">{s.ora}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="hint">Le date confermate vengono pubblicate anche nell'albo di gara</p>
      </div>
    </div>
  </section>

  <!-- SCHEDA GARA + DOCUMENTI RAPIDI -->
  <section id="scheda" class="wrap section sg" aria-labelledby="sg-h">
    <div class="sec-head">
      <h2 id="sg-h" class="type-h2">Tutto quello che serve, in una schermata</h2>
      <p class="type-body-dark">Le voci ci sono già tutte: si riempiono con la pubblicazione del regolamento particolare e dell'albo di gara, un mese prima della gara. Quello che vedi «da definire» non è dimenticato, è in lavorazione.</p>
    </div>
    <div class="sg__grid">
      <div class="sg__tab">
        <h3 class="type-h3 sg__t">Scheda della gara</h3>
        <dl class="sg__dl">
          {schedaGara.map(v => (
            <div class:list={['sg__r', { 'sg__r--vuota': !v.valore }]}>
              <dt>{v.voce}</dt>
              <dd>
                {v.valore ? <span class="sg__val">{v.valore}</span> : <span class="type-mono sg__soon">Da definire</span>}
                {v.nota && <span class="hint sg__nota">{v.nota}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="sg__doc">
        <h3 class="type-h3 sg__t">Documenti in evidenza</h3>
        <p class="type-body-dark sg__p">I file che si cercano per primi. Vengono pubblicati un mese prima della gara, qui e nell'albo di gara.</p>
        <ul class="sg__l">
          {documentiRapidi.map(d => (
            <li>
              {d.href ? (
                <a class="sg__d sg__d--on" href={d.href} target="_blank" rel="noopener">
                  <span class="sg__dn">{d.nome}{d.nota && <span class="type-mono sg__dk">{d.nota}</span>}</span>
                  <span class="type-mono sg__da">Scarica ↓</span>
                </a>
              ) : (
                <span class="sg__d sg__d--off">
                  <span class="sg__dn">{d.nome}{d.nota && <span class="type-mono sg__dk">{d.nota}</span>}</span>
                  <span class="type-mono sg__da">Un mese prima</span>
                </span>
              )}
            </li>
          ))}
        </ul>
        <a class="type-mono link-line sg__all" href="/rally-colli-euganei/documenti/">Vai all'albo di gara completo <span class="arrow-x" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ALBO (fondo bianco) -->
  <section class="on-light" aria-labelledby="albo-h">
    <div class="wrap section albo">
      <div>
        <p class="type-mono albo__k">Albo di gara digitale</p>
        <h2 id="albo-h" class="type-h2">Documenti di gara</h2>
        <p class="albo__p">Regolamento, programma, tabella tempi, comunicazioni del direttore di gara e modulistica.</p>
        <p class="albo__p">Ogni documento è numerato, datato e vale nella sua ultima versione. L'albo resta aggiornato fino al giorno di gara.</p>
      </div>
      <a href="/rally-colli-euganei/documenti/" class="btn btn--ev">Apri l'albo di gara</a>
    </div>
  </section>

  <!-- ELENCO ISCRITTI -->
  <section id="elenco-iscritti" class="wrap section el" aria-labelledby="el-h">
    <div class="el__head">
      <div>
        <h2 id="el-h" class="type-h2">Elenco iscritti</h2>
        <p class="type-body-dark">Tutti gli equipaggi ammessi. Cerca il tuo nome o filtra per classe.</p>
      </div>
      {iscrittiPdf && <span class="el__pdf"><a class="link-box" href={iscrittiPdf} target="_blank" rel="noopener">Scarica l'elenco iscritti in PDF ↓</a><span class="hint">Il PDF è il documento ufficiale · si apre in una nuova pagina</span></span>}
    </div>
    {haIscritti ? (
      <div class="el__body" data-iscritti>
        <div class="el__filtri">
          <label class="field el__classe"><span>Classe</span>
            <select name="classe" data-f-classe><option value="">Tutte le classi</option>{classi.map(c => <option value={c}>{c}</option>)}</select>
          </label>
          <label class="field el__cerca"><span>Cerca per cognome, vettura o numero di gara</span><input type="search" name="q" placeholder="Es. Fabia, Sartori, 4" data-f-q /></label>
          <p class="hint el__conta" aria-live="polite" data-conta>{iscritti.length} equipaggi su {iscritti.length}</p>
        </div>
        <div class="tbl-wrap">
          <table class="tbl tbl--cards">
            <caption class="type-mono">Elenco iscritti{iscrittiAggiornatoAl && ` · aggiornato al ${iscrittiAggiornatoAl}`}</caption>
            <thead><tr><th scope="col">N° di gara</th><th scope="col">Equipaggio</th><th scope="col">Vettura</th><th scope="col">Classe</th></tr></thead>
            <tbody>
              {iscritti.map(i => <tr data-classe={i.classe} data-testo={`${i.equipaggio} ${i.vettura} ${i.num}`.toLowerCase()}><th scope="row" class="num">N° {i.num}</th><td class="el__eq" data-label="Equipaggio">{i.equipaggio}</td><td data-label="Vettura">{i.vettura}</td><td class="type-mono" data-label="Classe">{i.classe}</td></tr>)}
            </tbody>
          </table>
        </div>
        <div class="el__vuoto" hidden data-vuoto>
          <p role="status" aria-live="polite">Nessun equipaggio corrisponde alla ricerca. Prova con un cognome, con il nome della vettura o con il numero di gara.</p>
          <button type="button" class="btn btn--secondary" data-reset>Cancella la ricerca</button>
        </div>
      </div>
    ) : (
      <div class="card card--left reveal">
        <p role="status" class="el__attesa">L'elenco degli equipaggi ammessi viene pubblicato nella settimana di gara. Lo trovi qui, leggibile dal telefono e scaricabile in PDF.</p>
      </div>
    )}
  </section>

  <!-- CLASSIFICHE LIVE -->
  <section id="classifiche" class="wrap section cls" aria-labelledby="cls-h">
    <div class="cls__head">
      <h2 id="cls-h" class="type-h2">Classifica live</h2>
      <p class="type-body-dark cls__intro">Durante la gara i tempi delle prove speciali e la classifica generale sono pubblicati in tempo reale dal servizio di cronometraggio.</p>
    </div>
    <div class="card card--top cls__box reveal">
      {rally.classificheUrl ? (
        <>
          <a class="btn btn--ev" href={rally.classificheUrl} target="_blank" rel="noopener">Apri la classifica live ↗</a>
          <span class="hint">Si apre in una nuova pagina, sul sito del servizio di cronometraggio</span>
        </>
      ) : (
        <>
          <span class="link-box link-box--off">Disponibile il weekend della gara</span>
          <span class="hint">Il collegamento al servizio di cronometraggio si attiva qui il 21 e 22 novembre. Le classifiche ufficiali restano quelle pubblicate nell'albo di gara.</span>
        </>
      )}
    </div>
  </section>
</Base>

<script>
  import '../../scripts/mailform';
  // filtro elenco iscritti (classe + ricerca), tutto lato client, senza dipendenze
  const box = document.querySelector<HTMLElement>('[data-iscritti]');
  if (box) {
    const sel = box.querySelector<HTMLSelectElement>('[data-f-classe]')!;
    const q = box.querySelector<HTMLInputElement>('[data-f-q]')!;
    const rows = [...box.querySelectorAll<HTMLTableRowElement>('tbody tr')];
    const conta = box.querySelector<HTMLElement>('[data-conta]')!;
    const vuoto = box.querySelector<HTMLElement>('[data-vuoto]')!;
    const tbl = box.querySelector<HTMLElement>('.tbl-wrap')!;
    const run = () => {
      const c = sel.value, t = q.value.trim().toLowerCase();
      let n = 0;
      rows.forEach(r => { const ok = (!c || r.dataset.classe === c) && (!t || (r.dataset.testo ?? '').includes(t)); r.hidden = !ok; if (ok) n++; });
      conta.textContent = `${n} equipaggi su ${rows.length}`;
      vuoto.hidden = n > 0; tbl.hidden = n === 0;
    };
    sel.addEventListener('change', run); q.addEventListener('input', run);
    box.querySelector('[data-reset]')?.addEventListener('click', () => { sel.value = ''; q.value = ''; run(); q.focus(); });
  }
</script>

<style>
  .avviso{gap:8px}
  .avviso__k{color:var(--alert-rosso-chiaro)}
  .avviso__p{color:#fff;max-width:80ch}
  .isc h2{color:#fff;margin-bottom:8px}
  .isc__intro{max-width:56ch;margin-bottom:var(--sp-5)}
  .isc__grid{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-6)}
  @media(min-width:900px){.isc__grid{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr)}}
  .isc__col{display:flex;flex-direction:column;gap:var(--sp-4);min-width:0}
  .isc__col h3{color:#fff}
  .avviso-form{display:flex;flex-direction:column;gap:8px;margin-top:8px}
  .avviso-form__row{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end}
  .avviso-form__row .field{flex:1 1 220px}
  .isc__cta{display:flex;flex-direction:column;gap:8px;align-items:flex-start;margin-top:8px}
  .cls__head{margin-bottom:var(--sp-3)}
  .cls h2{color:#fff;margin-bottom:8px}
  .cls__intro{max-width:60ch}
  .cls__box{display:flex;flex-direction:column;gap:10px;align-items:flex-start;max-width:80ch}
  .req{display:flex;flex-direction:column;gap:12px}
  .req__head{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .req .hint a{color:#fff}
  .tbl--scad{min-width:0}
  .tbl--scad td{white-space:nowrap}
  /* albo (bianco) */
  .albo{display:flex;justify-content:space-between;align-items:center;gap:var(--sp-5);flex-wrap:wrap}
  .albo__k{color:var(--rally-teal-scuro);margin-bottom:12px}
  .albo h2{margin-bottom:12px}
  .albo__p{color:var(--text-secondary);max-width:60ch;margin-bottom:8px}
  /* elenco */
  .el h2{color:#fff;margin-bottom:8px}
  .el__head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:var(--sp-4)}
  .el__pdf{display:flex;flex-direction:column;gap:6px;align-items:flex-start}
  .el__body{display:flex;flex-direction:column;gap:16px}
  .el__filtri{display:grid;grid-template-columns:minmax(0,1fr);gap:16px;align-items:end}
  @media(min-width:768px){.el__filtri{grid-template-columns:220px 1fr auto}}
  .el__eq{font-weight:600;color:#fff}
  .el__vuoto{display:flex;flex-direction:column;gap:16px;align-items:flex-start;padding:var(--sp-4);border:1px solid var(--border-on-dark)}
  .el__vuoto p{color:#DDD}
  .el__attesa{color:#DDD !important;max-width:70ch}
  /* scheda gara + documenti rapidi */
  .sg .sec-head{display:flex;flex-direction:column;gap:8px;margin-bottom:var(--sp-4)}
  .sg .sec-head p{max-width:70ch}
  .sg__grid{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-5)}
  @media(min-width:900px){.sg__grid{grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:var(--sp-6);align-items:start}}
  .sg__t{color:#fff;margin-bottom:12px}
  .sg__p{margin-bottom:16px;max-width:44ch}
  .sg__dl{display:flex;flex-direction:column;border-top:1px solid var(--border-on-dark)}
  .sg__r{display:grid;grid-template-columns:minmax(0,1fr);gap:2px;padding:12px 0;border-bottom:1px solid var(--border-on-dark)}
  @media(min-width:560px){.sg__r{grid-template-columns:minmax(0,15em) minmax(0,1fr);gap:20px;align-items:baseline}}
  .sg__r dt{color:var(--grigio-450);font-size:14px}
  .sg__r dd{margin:0;display:flex;flex-direction:column;gap:2px;min-width:0}
  .sg__val{color:#fff}
  .sg__soon{color:var(--grigio-450);font-size:12px}
  .sg__r--vuota dt{color:#6B6B6B}
  .sg__nota{color:var(--grigio-450)}
  .sg__l{display:flex;flex-direction:column;gap:8px}
  .sg__d{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px 16px;border:1px solid var(--border-on-dark);background:var(--carbone)}
  .sg__d--on{text-decoration:none;transition:border-color var(--dur-fast) var(--ease-out)}
  .sg__d--on:hover,.sg__d--on:focus-visible{border-color:var(--ev)}
  .sg__dn{color:#fff;font-size:15px;display:flex;flex-direction:column;gap:2px;min-width:0}
  .sg__dk{color:var(--grigio-450);font-size:11px}
  .sg__da{flex:none;font-size:11px}
  .sg__d--on .sg__da{color:var(--ev)}
  .sg__d--off{opacity:.62}
  .sg__d--off .sg__da{color:var(--grigio-450)}
  .sg__all{display:inline-flex;margin-top:16px;color:#fff}
</style>
