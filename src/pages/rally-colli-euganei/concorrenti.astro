---
/** Rally — Concorrenti: iscrizioni (3 stati), licenze, scadenze, albo, elenco iscritti con filtro, classifiche live. */
import '../../styles/hub.css';
import Base from '../../layouts/Base.astro';
import EventSubnav from '../../components/EventSubnav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { subnav, classi, schedaGara, schedaGaraPrima, documentiRapidi, liveTimingAttivo, unMesePrima, domandeOnline, moduliIscrizionePdf } from '../../data/rally';
import { caricaRally } from '../../lib/contenuti';
const { rally, scadenze, iscritti, iscrittiAggiornatoAl, iscrittiPdf, documenti } = await caricaRally();
const url = '/rally-colli-euganei/concorrenti/';
const stato = rally.statoIscrizioni;
const isc = {
  'non-aperte': { kicker: 'Iscrizioni dal 22 ottobre', titolo: 'Iscrizioni in area riservata ACI', testo: `La domanda di iscrizione si compila nell'area riservata ACI Sport e con i moduli qui sotto. Si accendono ${rally.aperturaPrevista}.` },
  'aperte': { kicker: 'Iscrizioni aperte', titolo: `Iscrizioni aperte fino al ${rally.chiusuraIscrizioni}, ore ${rally.chiusuraIscrizioniOra}`, testo: 'Compila la domanda online: servono licenza, dati della vettura e del navigatore. Equipaggi esteri e ricognitori usano invece il modulo PDF, da inviare per email con la copia del bonifico.' },
  'chiuse': { kicker: 'Iscrizioni chiuse', titolo: 'Iscrizioni chiuse', testo: `Le iscrizioni si sono chiuse il ${rally.chiusuraIscrizioni} alle ${rally.chiusuraIscrizioniOra}. Gli equipaggi ammessi sono nell'elenco iscritti qui sotto.` },
}[stato];
const haIscritti = iscritti.length > 0;
/** La scheda gara compilata esce con i documenti, a mezzanotte fra il 22 e il 23 ottobre.
 *  Prima di allora restano le voci senza valori. */
const scheda = unMesePrima() ? schedaGara : schedaGaraPrima;
/** Alcuni documenti rapidi arrivano dall'albo per numero (la cartina del percorso):
 *  il link si accende da solo il giorno in cui la riga d'albo diventa pubblica. */
const rapidi = documentiRapidi.map(d => d.albo
  ? { ...d, href: documenti.find(x => x.num === d.albo && !x.superato)?.href ?? '' }
  : d);
/** Modulistica e allegati pubblicati in albo: compaiono qui da soli, senza toccare il codice. */
const chiaveNum = (n: string) => String(n ?? '').split('.').map(x => Number(x) || 0);
const moduli = documenti
  .filter(d => !d.superato && d.href && (d.gruppo === 'Modulistica' || d.gruppo === 'Allegati tecnici'))
  .sort((a, b) => { const A = chiaveNum(a.num), B = chiaveNum(b.num); for (let i = 0; i < Math.max(A.length, B.length); i++) { const x = (A[i] ?? 0) - (B[i] ?? 0); if (x) return x; } return 0; });
/** I due moduli in PDF dell'iscrizione, presi dall'albo per numero: così il collegamento
 *  è sempre quello dell'ultima versione pubblicata, e se non sono ancora in albo il
 *  riquadro mostra solo le domande online. */
const moduliIscrizione = moduliIscrizionePdf.map(n => moduli.find(d => d.num === n)).filter(Boolean) as typeof moduli;
/** Area riservata ACI Sport: chi si iscrive deve registrarsi lì. Il link si attiva da solo il 23 ottobre 2026. */
const aciAreaRiservata = 'https://www.acisport.it/it/acisport/area-riservata/login';
const aciAreaRiservataAttiva = unMesePrima();
---
<Base
  title="Iscrizioni Rally Colli Euganei 2026 | Inversione A U"
  description="Come iscriversi al 1° Rally Colli Euganei ACI Sport: licenze richieste, scadenze, modulo di iscrizione ed elenco degli equipaggi ammessi."
  active="rally" bodyClass="ctx-rally" image="/img/social/rally-colli-euganei.jpg" imageAlt="1° Rally Colli Euganei ACI Sport, 21–22 novembre 2026"
>
  <EventSubnav items={subnav()} current={url} bg="#006C7C" accent="#00BA89" label="Sezioni del Rally Colli Euganei" />
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Rally Colli Euganei', href: rally.base }, { label: 'Concorrenti' }]} />

  <header class="wrap pg-head">
    <h1 class="type-h1">{stato === 'aperte' ? 'Area concorrenti: iscrizioni aperte' : 'Concorrenti: iscrizione al Rally Colli Euganei'}</h1>
    {!unMesePrima() && <p class="lead">Come iscriversi, quali licenze servono, quali documenti scaricare e chi è ammesso alla partenza.</p>}
    {unMesePrima() && <p class="pg-head__stato"><span class="pill">Informazioni in aggiornamento</span></p>}
  </header>

  {!unMesePrima() && (
    <div class="wrap">
      <div class="card card--rosso avviso" role="note">
        <span class="type-mono avviso__k">Elenco provvisorio</span>
        <p class="avviso__p">Le informazioni di questa pagina non sono ancora definitive. Fanno fede il Regolamento Particolare di Gara, in fase di approvazione, e le disposizioni ACI Sport, che pubblichiamo nell'albo di gara. Verifica l'ultima versione prima di iscriverti.</p>
        <span class="hint">Ultima revisione · 28 AGO 2026</span>
      </div>
    </div>
  )}

  <!-- ISCRIZIONI -->
  <section id="iscrizioni" class="wrap section isc" aria-labelledby="isc-h">
    <h2 id="isc-h" class="type-h2">Iscrizioni e licenze</h2>
    {!unMesePrima() && <p class="type-body-dark isc__intro">Stato delle iscrizioni, licenza e date da tenere sotto controllo.</p>}
    <div class:list={['isc__grid', { 'isc__grid--mono': unMesePrima() }]}>
      <div class="isc__col">
        <div class="card card--top reveal">
          <span class="type-mono k-ev">{isc.kicker}</span>
          <h3 class="type-h3">{isc.titolo}</h3>
          <p>{isc.testo}</p>
          {stato === 'non-aperte' && (
            <div class="isc__cta isc__cta--moduli">
              <ul class="sg__l">
                {domandeOnline.map(d => (
                  <li>
                    <span class="sg__d sg__d--off">
                      <span class="sg__dn">{d.nome}<span class="type-mono sg__dk">{d.nota}</span></span>
                      <span class="type-mono sg__da">{rally.aperturaPrevista.replace('il ', 'dal ')}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {stato === 'aperte' && (
            <div class="isc__cta isc__cta--moduli">
              <ul class="sg__l">
                {domandeOnline.map(d => (
                  <li>
                    <a class="sg__d sg__d--on" href={d.url} target="_blank" rel="noopener">
                      <span class="sg__dn">{d.nome}<span class="type-mono sg__dk">{d.nota}</span></span>
                      <span class="type-mono sg__da">Apri ↗<span class="sr-only"> Si apre in una nuova pagina</span></span>
                    </a>
                  </li>
                ))}
                {moduliIscrizione.map(d => (
                  <li>
                    <a class="sg__d sg__d--on" href={d.href} target="_blank" rel="noopener">
                      <span class="sg__dn">{d.title}<span class="type-mono sg__dk">{d.num} · {d.file}</span></span>
                      <span class="type-mono sg__da">Scarica ↓</span>
                    </a>
                  </li>
                ))}
              </ul>
              <span class="hint">I moduli in PDF, compilati e firmati, vanno inviati a <a href={`mailto:${rally.email}`}>{rally.email}</a> con la copia del bonifico, entro la chiusura delle iscrizioni.</span>
              <p>{unMesePrima() ? 'La segreteria conferma per email.' : "Dopo l'invio riceverai la conferma dalla segreteria."}</p>
            </div>
          )}
          {stato === 'chiuse' && <a href="#elenco-iscritti" class="btn btn--secondary">Vai all'elenco iscritti</a>}
        </div>
        <div class="req">
          <div class="req__head"><h3 class="type-h3">Licenza</h3></div>
          <p class="type-body-dark">{unMesePrima() ? 'Controlla sul sito ACI Sport che la tua licenza sia valida per questo evento.' : 'Verifica la validità della propria licenza per questo evento sul sito ACI Sport.'}</p>
          <div class="req__cta">
            <a class="link-box" href="https://www.acisport.it/it/acisport" target="_blank" rel="noopener">Vai al sito ACI Sport ↗</a>
            {aciAreaRiservataAttiva ? (
              <a class="link-box" href={aciAreaRiservata} target="_blank" rel="noopener">Registrati nell'area riservata ↗</a>
            ) : (
              <span class="link-box link-box--off">Area riservata ACI Sport <span class="type-mono lb__q">dal 23 ottobre</span></span>
            )}
          </div>
          <span class="hint">{unMesePrima() ? 'Le licenze ammesse sono indicate nel Regolamento Particolare di Gara, in fase di approvazione' : 'Si apre in una nuova pagina · le licenze ammesse sono indicate nel Regolamento Particolare di Gara, in fase di approvazione'}</span>
          <p class="hint">{unMesePrima() ? "Prima gara con licenza ACI Sport? Registrati nell'area riservata ACI: la domanda si compila da lì." : "Chi non ha mai gareggiato con licenza ACI Sport deve prima registrarsi nell'area riservata del sito ACI: la domanda di iscrizione si compila da lì."}</p>
          <p class="hint">{unMesePrima() ? 'Dubbi? Scrivi a ' : 'In caso di dubbio scrivi a '}<a href={`mailto:${rally.email}`}>{rally.email}</a></p>
        </div>
      </div>
      {!unMesePrima() && (
      <div class="isc__col">
        <h3 class="type-h3">Date da segnare</h3>
        <div class="tbl-wrap">
          <table class="tbl tbl--scad tbl--cards">
            <thead><tr><th scope="col">Fase</th><th scope="col">Data</th><th scope="col">Ora</th></tr></thead>
            <tbody>{scadenze.map(s => <tr><th scope="row">{s.fase}</th><td data-label="Data">{s.data}</td><td class:list={['tabular', { 'is-vuota': !s.ora || s.ora === '—' }]} data-label="Ora">{s.ora}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="hint">{unMesePrima() ? "Le date confermate sono anche nell'albo di gara" : "Le date confermate vengono pubblicate anche nell'albo di gara"}</p>
      </div>
      )}
    </div>
  </section>

  <!-- SCHEDA GARA + DOCUMENTI RAPIDI -->
  <section id="scheda" class="wrap section sg" aria-labelledby="sg-h">
    <div class="sec-head">
      <h2 id="sg-h" class="type-h2">Tutto quello che serve, in una schermata</h2>
      {unMesePrima() && <p class="hint sg__tag">Gli orari del programma potrebbero subire variazioni.</p>}
      {!unMesePrima() && <p class="type-body-dark">Le voci ci sono già tutte: si riempiono con la pubblicazione del regolamento particolare, oggi in fase di approvazione, e dell'albo di gara. Quello che vedi «da definire» non è dimenticato, è in lavorazione.</p>}
    </div>
    <div class="sg__grid">
      <div class="sg__tab">
        <h3 class="type-h3 sg__t">Scheda della gara</h3>
        <dl class="sg__dl">
          {scheda.map(v => (
            <div class:list={['sg__r', { 'sg__r--vuota': !v.valore }]}>
              <dt>{v.voce}</dt>
              <dd>
                {v.valore ? <span class="sg__val">{v.valore}</span> : <span class="type-mono sg__soon">Da definire</span>}
                {v.nota && <span class="hint sg__nota">{v.nota}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="sg__doc">
        <h3 class="type-h3 sg__t">Documenti in evidenza</h3>
        {!unMesePrima() && <p class="type-body-dark sg__p">{moduli.length
          ? (unMesePrima() ? 'I file più cercati. La modulistica è scaricabile, il resto è in arrivo.' : 'I file che si cercano per primi. La modulistica è già scaricabile, il resto è in arrivo.')
          : "I file che si cercano per primi. Sono in arrivo, qui e nell'albo di gara."}</p>}
        <ul class="sg__l">
          {rapidi.map(d => (
            <li>
              {d.href ? (
                <a class="sg__d sg__d--on" href={d.href} target="_blank" rel="noopener">
                  <span class="sg__dn">{d.nome}{d.nota && <span class="type-mono sg__dk">{d.nota}</span>}</span>
                  <span class="type-mono sg__da">Scarica ↓</span>
                </a>
              ) : (
                <span class="sg__d sg__d--off">
                  <span class="sg__dn">{d.nome}{d.nota && <span class="type-mono sg__dk">{d.nota}</span>}</span>
                  <span class="type-mono sg__da">In arrivo</span>
                </span>
              )}
            </li>
          ))}
        </ul>
        {moduli.length > 0 && (
          <>
            <h4 class="type-mono sg__sub">Modulistica da compilare</h4>
            <ul class="sg__l">
              {moduli.map(d => (
                <li>
                  <a class="sg__d sg__d--on" href={d.href} target="_blank" rel="noopener">
                    <span class="sg__dn">{d.title}<span class="type-mono sg__dk">{d.num} · {d.file}</span></span>
                    <span class="type-mono sg__da">Scarica ↓</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        <a class="type-mono link-line sg__all" href="/rally-colli-euganei/documenti/">Vai all'albo di gara completo <span class="arrow-x" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ALBO (fondo bianco) -->
  <section class="on-light" aria-labelledby="albo-h">
    <div class="wrap section albo">
      <div>
        <p class="type-mono albo__k">Albo di gara digitale</p>
        <h2 id="albo-h" class="type-h2">Documenti di gara</h2>
        <p class="albo__p">{unMesePrima() ? 'Regolamento, programma, tabella tempi, comunicazioni del direttore di gara, modulistica.' : 'Regolamento, programma, tabella tempi, comunicazioni del direttore di gara e modulistica.'}</p>
        {!unMesePrima() && <p class="albo__p">Ogni documento è numerato, datato e vale nella sua ultima versione. L'albo resta aggiornato fino al giorno di gara.</p>}
      </div>
      <a href="/rally-colli-euganei/documenti/" class="btn btn--ev">Apri l'albo di gara</a>
    </div>
  </section>

  <!-- ELENCO ISCRITTI -->
  <section id="elenco-iscritti" class="wrap section el" aria-labelledby="el-h">
    <div class="el__head">
      <div>
        <h2 id="el-h" class="type-h2">Elenco iscritti</h2>
        <p class="type-body-dark">Tutti gli equipaggi ammessi. Cerca il tuo nome o filtra per classe.</p>
      </div>
      {iscrittiPdf && <span class="el__pdf"><a class="link-box" href={iscrittiPdf} target="_blank" rel="noopener">Scarica l'elenco iscritti in PDF ↓</a><span class="hint">Il PDF è il documento ufficiale · si apre in una nuova pagina</span></span>}
    </div>
    {haIscritti ? (
      <div class="el__body" data-iscritti>
        <div class="el__filtri">
          <label class="field el__classe"><span>Classe</span>
            <select name="classe" data-f-classe><option value="">Tutte le classi</option>{classi.map(c => <option value={c}>{c}</option>)}</select>
          </label>
          <label class="field el__cerca"><span>Cerca per cognome, vettura o numero di gara</span><input type="search" name="q" placeholder="Es. Fabia, Sartori, 4" data-f-q /></label>
          <p class="hint el__conta" aria-live="polite" data-conta>{iscritti.length} equipaggi su {iscritti.length}</p>
        </div>
        <div class="tbl-wrap">
          <table class="tbl tbl--cards">
            <caption class="type-mono">Elenco iscritti{iscrittiAggiornatoAl && ` · aggiornato al ${iscrittiAggiornatoAl}`}</caption>
            <thead><tr><th scope="col">N° di gara</th><th scope="col">Equipaggio</th><th scope="col">Vettura</th><th scope="col">Classe</th></tr></thead>
            <tbody>
              {iscritti.map(i => <tr data-classe={i.classe} data-testo={`${i.equipaggio} ${i.vettura} ${i.num}`.toLowerCase()}><th scope="row" class="num">N° {i.num}</th><td class="el__eq" data-label="Equipaggio">{i.equipaggio}</td><td data-label="Vettura">{i.vettura}</td><td class="type-mono" data-label="Classe">{i.classe}</td></tr>)}
            </tbody>
          </table>
        </div>
        <div class="el__vuoto" hidden data-vuoto>
          <p role="status" aria-live="polite">Nessun equipaggio corrisponde alla ricerca. Prova con un cognome, con il nome della vettura o con il numero di gara.</p>
          <button type="button" class="btn btn--secondary" data-reset>Cancella la ricerca</button>
        </div>
      </div>
    ) : (
      <div class="card card--left reveal">
        <p role="status" class="el__attesa">{unMesePrima() ? "L'elenco esce nella settimana di gara: qui, leggibile dal telefono, e in PDF." : "L'elenco degli equipaggi ammessi viene pubblicato nella settimana di gara. Lo trovi qui, leggibile dal telefono e scaricabile in PDF."}</p>
      </div>
    )}
  </section>

  <!-- CLASSIFICHE LIVE -->
  <section id="classifiche" class="wrap section cls" aria-labelledby="cls-h">
    <div class="cls__head">
      <h2 id="cls-h" class="type-h2">Classifica live</h2>
      <p class="type-body-dark cls__intro">{unMesePrima() ? 'Durante la gara, tempi delle prove e classifica generale in tempo reale dal servizio di cronometraggio.' : 'Durante la gara i tempi delle prove speciali e la classifica generale sono pubblicati in tempo reale dal servizio di cronometraggio.'}</p>
    </div>
    <div class="card card--top cls__box reveal">
      {liveTimingAttivo() ? (
        <>
          <a class="btn btn--ev" href={rally.classificheUrl} target="_blank" rel="noopener">Apri il live timing ↗</a>
          <span class="hint">Si apre in una nuova pagina, sul sito del servizio di cronometraggio</span>
        </>
      ) : (
        <>
          <span class="link-box link-box--off">Disponibile dalla settimana di gara</span>
          <span class="hint">{unMesePrima() ? "Il collegamento si attiva qui dal 14 novembre. Le classifiche ufficiali restano quelle dell'albo di gara." : "Il collegamento al servizio di cronometraggio si attiva qui dal 14 novembre, e compare anche nel menù del rally. Le classifiche ufficiali restano quelle pubblicate nell'albo di gara."}</span>
        </>
      )}
    </div>
  </section>
</Base>

<script>
  import '../../scripts/mailform';
  // filtro elenco iscritti (classe + ricerca), tutto lato client, senza dipendenze
  const box = document.querySelector<HTMLElement>('[data-iscritti]');
  if (box) {
    const sel = box.querySelector<HTMLSelectElement>('[data-f-classe]')!;
    const q = box.querySelector<HTMLInputElement>('[data-f-q]')!;
    const rows = [...box.querySelectorAll<HTMLTableRowElement>('tbody tr')];
    const conta = box.querySelector<HTMLElement>('[data-conta]')!;
    const vuoto = box.querySelector<HTMLElement>('[data-vuoto]')!;
    const tbl = box.querySelector<HTMLElement>('.tbl-wrap')!;
    const run = () => {
      const c = sel.value, t = q.value.trim().toLowerCase();
      let n = 0;
      rows.forEach(r => { const ok = (!c || r.dataset.classe === c) && (!t || (r.dataset.testo ?? '').includes(t)); r.hidden = !ok; if (ok) n++; });
      conta.textContent = `${n} equipaggi su ${rows.length}`;
      vuoto.hidden = n > 0; tbl.hidden = n === 0;
    };
    sel.addEventListener('change', run); q.addEventListener('input', run);
    box.querySelector('[data-reset]')?.addEventListener('click', () => { sel.value = ''; q.value = ''; run(); q.focus(); });
  }
</script>

<style>
  .avviso{gap:8px}
  .avviso__k{color:var(--alert-rosso-chiaro)}
  .avviso__p{color:#fff}
  .isc{padding-top:var(--sp-8)}
  @media(min-width:900px){.isc{padding-top:var(--sp-10)}}
  .isc h2{color:#fff;margin-bottom:8px}
  .isc__intro{max-width:56ch;margin-bottom:var(--sp-5)}
  .sg__tag{margin-top:6px}
  .isc__grid{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-6)}
  @media(min-width:900px){.isc__grid:not(.isc__grid--mono){grid-template-columns:minmax(0,1.2fr) minmax(0,1fr)}}
  .isc__col{display:flex;flex-direction:column;gap:var(--sp-4);min-width:0}
  .isc__col h3{color:#fff}
  .avviso-form{display:flex;flex-direction:column;gap:8px;margin-top:8px}
  .avviso-form__row{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end}
  .avviso-form__row .field{flex:1 1 220px}
  .isc__cta{display:flex;flex-direction:column;gap:8px;align-items:flex-start;margin-top:8px}
  .isc__cta--moduli{align-items:stretch}
  .isc__cta--moduli .sg__l{width:100%}
  .cls__head{margin-bottom:var(--sp-3)}
  .cls h2{color:#fff;margin-bottom:8px}
  .cls__intro{max-width:60ch}
  .cls__box{display:flex;flex-direction:column;gap:10px;align-items:flex-start}
  .req{display:flex;flex-direction:column;gap:12px}
  .req__head{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .req .hint a{color:#fff}
  .req__cta{display:flex;flex-direction:column;gap:10px;align-items:flex-start}
  @media(min-width:560px){.req__cta{flex-direction:row;flex-wrap:wrap;align-items:center}}
  .link-box--off{opacity:.62}
  .link-box--off .lb__q{color:var(--grigio-450)}
  /* stesso problema del blocco moduli: a fianco del testo l'etichetta «dal 23 ottobre»
     spezzava «Area riservata ACI / Sport» a metà. Su telefono va sotto. */
  @media(max-width:639px){
    .link-box--off{flex-direction:column;align-items:flex-start;gap:4px}
  }
  .tbl--scad{min-width:0}
  .tbl--scad td{white-space:nowrap}
  /* Date da segnare su telefono: la fase in testa, data e ora sulla stessa riga.
     Senza questo ogni scadenza occupa cinque righe (fase, ETICHETTA DATA, data, ETICHETTA ORA, ora). */
  @media(max-width:639px){
    .tbl--scad tbody tr{padding:12px 0}
    .tbl--scad tbody th{margin-bottom:2px}
    .tbl--scad tbody td,.tbl--scad tbody td[data-label]{display:inline;margin:0;white-space:normal}
    .tbl--scad tbody td[data-label]::before{content:none}
    .tbl--scad tbody td[data-label="Ora"]::before{content:'·';color:var(--grigio-500);margin:0 6px}
    .tbl--scad tbody td.is-vuota{display:none}
  }
  /* albo (bianco) */
