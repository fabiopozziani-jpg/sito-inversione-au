---
import '../../../styles/hub.css';
import Base from '../../../layouts/Base.astro';
import EventHub from '../../../components/EventHub.astro';
import { eventLd } from '../../../data/hub';
import { caricaHub, caricaGallerie, caricaSponsor } from '../../../lib/contenuti';
const [hub, gallerie, sponsor] = await Promise.all([caricaHub('legnaro'), caricaGallerie(), caricaSponsor()]);
---
<Base title="Legnaro Motori 2026 — 15 marzo | Inversione A U" description="Legnaro Motori: una giornata di drift e raduno a Legnaro (Padova). Programma, mappa dell'area, foto della prima edizione, sponsor e contatti." active="eventi" bodyClass="ctx-legnaro" image="/img/social/legnaro-motori.jpg" imageAlt="Legnaro Motori 2026" jsonld={eventLd(hub)}>
  <EventHub h={hub} gallerie={gallerie} sponsor={sponsor} />
</Base>
