---
/** Diventa sponsor — numeri, due pacchetti, confronto, partner tecnico, espositori, modulo. */
import '../../../styles/hub.css';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import StatBlock from '../../../components/StatBlock.astro';
const email = 'inversione.au3@gmail.com';
const numeri = [
  { value: '15.000+', label: 'spettatori · 2026' }, { value: '~100', label: 'equipaggi · 2026' }, { value: '300+', label: 'auto esposte · 2026' }, { value: '23', label: 'sponsor · 2026' },
  { value: '4', label: 'espositori · 2026' }, { value: '30+', label: 'staff in servizio' }, { value: '8', label: 'fotografi e videomaker' }, { value: '2', label: 'aree food' },
];
const pacchetti = [
  { id: 'Partner di stagione', kicker: 'Stagione', nome: 'Partner di stagione', testo: 'Presenza su tutti gli eventi della stagione, logo su sito e materiali stampati, ospitalità e report finale.', consigliato: true },
  { id: 'Sponsor di un singolo evento', kicker: 'Un evento', nome: 'Sponsor di un singolo evento', testo: 'Marchio su materiali e percorso di un evento a tua scelta, citazione nei comunicati, spazio espositivo.', consigliato: false },
];
const confronto: [string, string, string][] = [
  ['Eventi coperti', 'Tutti gli eventi della stagione (tre nel 2026)', 'Un evento a tua scelta'],
  ['Logo su questo sito', 'In home e nella pagina Sponsor, tutto l’anno', 'Nella pagina del tuo evento'],
  ['Logo sui materiali stampati', 'Su locandine, pieghevoli e cartellonistica di tutti gli eventi', 'Su locandine e cartellonistica del tuo evento'],
  ['Citazione nei comunicati stampa', 'In tutti i comunicati della stagione', 'Nei comunicati del tuo evento'],
  ['Spazio espositivo', 'Uno spazio in ogni evento', 'Uno spazio nel tuo evento'],
  ['Ospitalità per i tuoi ospiti', 'Sì, in ogni evento — posti da confermare', 'Su richiesta'],
  ['Report finale con i numeri', 'A fine stagione: presenze, foto, uscite stampa', 'Entro 30 giorni dall’evento'],
  ['Quanto costa', 'Si definisce insieme', 'Si definisce insieme'],
];
const settori = ['Automotive e ricambi', 'Officine e gommisti', 'Ristorazione e food', 'Edilizia e industria', 'Servizi e professionisti', 'Turismo e ospitalità', 'Altro'];
const eventi = ['Tutta la stagione 2027', '1° Rally Colli Euganei', 'Polo Motor Show', 'Legnaro Motori', 'Spazio espositivo'];
const pacchettiOpz = ['Partner di stagione', 'Sponsor di un singolo evento', 'Partner tecnico', 'Solo spazio espositivo', 'Non lo so ancora, voglio capire'];
const budget = ['Da definire', 'Fino a 1.000 €', '1.000 – 3.000 €', '3.000 – 10.000 €', 'Oltre 10.000 €', 'Fornitura di beni o servizi'];
---
<Base title="Diventa sponsor o espositore | Inversione A U" description="Come diventare sponsor degli eventi Inversione A U: partner di stagione, sponsor di un singolo evento, partner tecnico e spazi espositivi. Numeri, confronto dei pacchetti e modulo di richiesta." active="sponsor">
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Sponsor', href: '/sponsor/' }, { label: 'Diventa sponsor' }]} />
  <header class="wrap pg-head">
    <h1 class="type-h1">Diventa sponsor degli eventi motorsport</h1>
    <p class="lead">Due pacchetti, dal singolo evento alla stagione intera, più il partner tecnico per chi mette mezzi e servizi. Ogni proposta viene costruita insieme.</p>
  </header>

  <section id="numeri" class="wrap section" aria-labelledby="num-h">
    <div class="row-h"><h2 id="num-h" class="type-h2">I numeri di un nostro evento</h2><span class="hint">Stagione 2026 · dati consuntivi</span></div>
    <StatBlock stats={numeri} columns={4} />
    <p class="p">Il pubblico è locale e appassionato: arriva dai paesi del percorso e da tutto il Veneto. Nel 2026 firmiamo tre eventi: Legnaro Motori il 15 marzo, Polo Motor Show il 13 e 14 giugno, il 1° Rally Colli Euganei ACI Sport il 21 e 22 novembre.</p>
    <p class="p">Il rally è il motivo per cui vale la pena entrare adesso. Un rally torna sui Colli Euganei dopo più di trent'anni, e l'attenzione della stampa locale si concentra su questa edizione.</p>
  </section>

  <section id="pacchetti" class="wrap section" aria-labelledby="pk-h">
    <h2 id="pk-h" class="type-h2 mb">I due pacchetti a confronto</h2>
    <div class="pk stagger">
      {pacchetti.map(p => (
        <div class:list={['card', 'reveal', { 'pk--top': p.consigliato }]}>
          <div class="pk__k"><span class="type-mono text-meta">{p.kicker}</span>{p.consigliato && <span class="pill pill--pieno">Consigliato</span>}</div>
          <h3 class="type-h3">{p.nome}</h3>
          <p>{p.testo}</p>
          <span class="hint">Investimento da definire insieme</span>
          <a href="#form-sponsor" class="type-mono link-line pk__l" data-pack={p.id}>Scegli questo pacchetto <span class="arrow-x" aria-hidden="true">→</span></a>
        </div>
      ))}
    </div>
    <div class="tbl-wrap cmp">
      <table class="tbl tbl--cards">
        <caption class="type-mono">Cosa ricevi con ciascun pacchetto</caption>
        <thead><tr><th scope="col">Cosa ricevi</th><th scope="col">Partner di stagione</th><th scope="col">Sponsor di un evento</th></tr></thead>
        <tbody>{confronto.map(([v, a, e]) => <tr><th scope="row">{v}</th><td data-label="Partner di stagione">{a}</td><td data-label="Sponsor di un evento">{e}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="hint">Non pubblichiamo un listino. Ogni proposta si costruisce sull'azienda, sul settore e sull'evento scelto.</p>
    <div class="card card--left tec">
      <h3 class="type-h3">Partner tecnico: forniture in cambio di visibilità</h3>
      <p>Se la tua azienda fornisce mezzi, ristoro, stampa, materiali o servizi di sicurezza, possiamo riconoscerti una visibilità di valore equivalente senza scambio di denaro. Scrivici cosa puoi mettere a disposizione e ti diciamo cosa possiamo darti in cambio.</p>
    </div>
  </section>

  <section id="espositori" class="wrap section" aria-labelledby="es-h">
    <h2 id="es-h" class="type-h2">Spazio espositivo per la tua azienda</h2>
    <p class="p">Nelle ultime edizioni hanno esposto 4 aziende in un'area attraversata da oltre 15.000 persone in due giorni. Lo spazio comprende superficie assegnata, accesso allo scarico e passaggio dello staff. Corrente elettrica e gazebo su richiesta.</p>
    <p class="hint">Gli spazi sono limitati e assegnati in ordine di richiesta.</p>
  </section>

  <section id="form-sponsor" class="wrap section fs" aria-labelledby="fs-h">
    <div class="fs__t">
      <h2 id="fs-h" class="type-h2">Richiedi il progetto sponsor</h2>
      <p class="type-body-dark">Raccontaci l'azienda e l'evento che ti interessa: prepariamo una proposta con visibilità, materiali e report finale. Rispondiamo entro 3 giorni lavorativi.</p>
      <div class="card card--left"><span class="type-mono text-meta">Presentazione per gli sponsor</span><p>Presentazione eventi 2026 con numeri, foto e formati di visibilità: la inviamo per email a chi compila il modulo.</p><span class="hint">PDF · presentazione eventi 2026</span></div>
      <div class="card card--left"><span class="type-mono text-meta">Sei un espositore?</span><p>Lo spazio esposizione è un canale a sé: scegli «Spazio espositivo» come interesse nel modulo e ti mandiamo misure, costi e planimetria.</p></div>
    </div>
    <form class="form-box" data-mailform data-to={email} data-subject="Richiesta progetto sponsor · Inversione A U" novalidate>
      <div class="errbox" role="alert" tabindex="-1" hidden data-errors></div>
      <fieldset>
        <legend>La tua azienda</legend>
        <div class="f-grid">
          <label class="field f-full"><span>Azienda *</span><input type="text" name="azienda" autocomplete="organization" required /></label>
          <label class="field"><span>Referente *</span><input type="text" name="referente" autocomplete="name" required /></label>
          <label class="field"><span>Settore *</span><select name="settore" required>{settori.map(s => <option value={s}>{s}</option>)}</select></label>
          <label class="field"><span>Email *</span><input type="email" name="email" autocomplete="email" required /></label>
          <label class="field"><span>Telefono</span><input type="tel" name="telefono" autocomplete="tel" placeholder="Facoltativo, ma accorcia i tempi" /></label>
          <label class="field"><span>Evento di interesse *</span><select name="evento" required>{eventi.map(e => <option value={e}>{e}</option>)}</select></label>
          <label class="field"><span>Cosa ti interessa *</span><select name="pacchetto" required data-pacchetto>{pacchettiOpz.map(o => <option value={o}>{o}</option>)}</select></label>
          <label class="field"><span>Budget che hai in mente</span><select name="budget">{budget.map(b => <option value={b}>{b}</option>)}</select></label>
          <label class="field f-full"><span>Scrivi qui cosa vorresti ottenere</span><textarea name="note" rows="4" placeholder="Obiettivi, prodotti da promuovere, materiali che avete già"></textarea></label>
        </div>
      </fieldset>
      <label class="chk"><input type="checkbox" name="presentazione" checked /><span>Inviatemi la presentazione per gli sponsor via email</span></label>
      <label class="chk"><input type="checkbox" name="privacy" required /><span>Ho letto l'<a href="/privacy/">informativa privacy</a> e acconsento al trattamento dei dati per rispondere alla richiesta.</span></label>
      <button type="submit" class="btn btn--primary">Invia la richiesta</button>
      <p class="hint">Alla richiesta alleghiamo la presentazione eventi 2026 in PDF. Non usiamo il tuo indirizzo per altro e non lo cediamo a nessuno.</p>
      <p class="form-msg" role="status" aria-live="polite"></p>
    </form>
  </section>
</Base>
<script>
  import '../../../scripts/mailform';
  const sel = document.querySelector<HTMLSelectElement>('[data-pacchetto]');
  document.querySelectorAll<HTMLAnchorElement>('[data-pack]').forEach(a => a.addEventListener('click', () => { if (sel) sel.value = a.dataset.pack ?? ''; }));
</script>
<style>
  .pg-head{padding-top:var(--sp-4);padding-bottom:var(--sp-2);display:flex;flex-direction:column;gap:12px}
  .pg-head h1{color:#fff;max-width:22ch;text-wrap:balance}
  .lead{color:var(--text-body-on-dark);max-width:60ch;font-size:17px}
  h2{color:#fff}
  .mb{margin-bottom:var(--sp-4)}
  .row-h{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:var(--sp-4)}
  .p{color:#DDD;max-width:70ch;margin-top:16px}
  .pk{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--grid-gutter);margin-bottom:var(--sp-5)}
  @media(min-width:768px){.pk{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
  .pk--top{border-top:3px solid #fff}
  .pk__k{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .pk .pill--pieno{background:#fff;color:#000;border-color:#fff}
  .pk__l{color:#fff;align-self:flex-start;margin-top:auto}
  .cmp{margin-bottom:12px}
  .tec{margin-top:var(--sp-5);max-width:80ch}
  .fs{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-6);align-items:start}
  @media(min-width:900px){.fs{grid-template-columns:minmax(0,1fr) minmax(0,1.3fr)}}
  .fs__t{display:flex;flex-direction:column;gap:16px}
  .fs__t p{max-width:56ch}
</style>
