---
/** Diventa sponsor — numeri, formula unica, soluzioni su misura, espositori, modulo. */
import '../../../styles/hub.css';
import { presentazione, presentazionePeso } from '../../../data/filesWix';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import StatBlock from '../../../components/StatBlock.astro';
const email = 'inversione.au3@gmail.com';
const numeri = [
  { value: '10.000+', label: 'spettatori · 2026' }, { value: '~100', label: 'equipaggi · 2026' }, { value: '400+', label: 'auto esposte · 2026' }, { value: '23', label: 'sponsor · 2026' },
  { value: '4', label: 'espositori · 2026' }, { value: '30+', label: 'staff in servizio' }, { value: '8', label: 'fotografi e videomaker' }, { value: '2', label: 'aree food' },
];
/** Una sola formula: tutto quello che offriamo a chi sostiene la stagione. */
const comprende: [string, string][] = [
  ['Eventi coperti', 'Tutti gli eventi della stagione — tre nel 2026, dal drift al rally'],
  ['Logo su questo sito', 'In home e nella pagina Sponsor, tutto l’anno'],
  ['Logo sui materiali stampati', 'Locandine, pieghevoli e cartellonistica di tutti gli eventi'],
  ['Presenza sul percorso', 'Striscioni e allestimenti nelle aree di gara e nel paddock'],
  ['Citazione nei comunicati stampa', 'In tutti i comunicati della stagione'],
  ['Canali social', 'Contenuti dedicati sui nostri canali, oltre 29.000 persone raggiunte'],
  ['Spazio espositivo', 'Uno spazio in ogni evento della stagione'],
  ['Ospitalità per i tuoi ospiti', 'In ogni evento — posti da confermare edizione per edizione'],
  ['Report finale con i numeri', 'A fine stagione: presenze, foto, uscite stampa'],
  ['Quanto costa', 'Si definisce insieme, sull’azienda e sugli obiettivi'],
];
const settori = ['Automotive e ricambi', 'Officine e gommisti', 'Ristorazione e food', 'Edilizia e industria', 'Servizi e professionisti', 'Turismo e ospitalità', 'Altro'];
const eventi = ['Tutta la stagione 2027', '1° Rally Colli Euganei', 'Polo Motor Show', 'Legnaro Motori', 'Spazio espositivo'];
const pacchettiOpz = ['Sponsorizzazione di stagione', 'Un singolo evento', 'Partner tecnico · forniture', 'Solo spazio espositivo', 'Non lo so ancora, voglio capire'];
const budget = ['Da definire', 'Fino a 1.000 €', '1.000 – 3.000 €', '3.000 – 10.000 €', 'Oltre 10.000 €', 'Fornitura di beni o servizi'];
---
<Base title="Diventa sponsor o espositore | Inversione A U" description="Diventare sponsor degli eventi Inversione A U: cosa comprende la sponsorizzazione, soluzioni su misura, spazi espositivi e modulo di richiesta." active="sponsor">
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Sponsor', href: '/sponsor/' }, { label: 'Diventa sponsor' }]} />
  <header class="wrap pg-head">
    <h1 class="type-h1">Diventa sponsor degli eventi motorsport</h1>
    <p class="lead">Una sola formula, che copre tutta la stagione. Da lì costruiamo insieme la soluzione che serve alla tua azienda.</p>
  </header>

  <section id="numeri" class="wrap section" aria-labelledby="num-h">
    <div class="row-h"><h2 id="num-h" class="type-h2">I numeri di un nostro evento</h2><span class="hint">Stagione 2026 · dati consuntivi</span></div>
    <StatBlock stats={numeri} columns={4} />
    <p class="p">Il pubblico è locale e appassionato: arriva dai paesi del percorso e da tutto il Veneto. Nel 2026 firmiamo tre eventi: Legnaro Motori il 15 marzo, Polo Motor Show il 13 e 14 giugno, il 1° Rally Colli Euganei ACI Sport il 21 e 22 novembre.</p>
    <p class="p">Il rally è il motivo per cui vale la pena entrare adesso. Un rally torna nel Padovano dopo più di 35 anni, e l'attenzione della stampa locale si concentra su questa edizione.</p>
  </section>

  <section id="sponsorizzazione" class="wrap section" aria-labelledby="pk-h">
    <h2 id="pk-h" class="type-h2 mb">Cosa comprende la sponsorizzazione</h2>
    <p class="p">Una formula sola, per tutta la stagione: il marchio entra in ogni evento che organizziamo, sui materiali, nei comunicati e sui nostri canali. Gli eventi cambiano, la presenza resta.</p>
    <div class="tbl-wrap cmp">
      <table class="tbl tbl--cards">
        <caption class="type-mono">Cosa comprende la sponsorizzazione di stagione</caption>
        <thead><tr><th scope="col">Cosa ricevi</th><th scope="col">Come</th></tr></thead>
        <tbody>{comprende.map(([v, a]) => <tr><th scope="row">{v}</th><td data-label="Come">{a}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="hint">Non pubblichiamo un listino. Ogni proposta si costruisce sull'azienda, sul settore e sugli obiettivi.</p>
    <div class="card card--left tec">
      <h3 class="type-h3">Soluzioni su misura</h3>
      <p>Non tutte le aziende cercano la stessa cosa. Se la formula di stagione non è quello che ti serve, si parte da qui e si costruisce insieme:</p>
      <ul class="lista-ev">
        <li>Un singolo evento, quando ti interessa un pubblico o una data in particolare.</li>
        <li>Partner tecnico: mezzi, ristoro, stampa, materiali o servizi di sicurezza in cambio di visibilità di valore equivalente, senza scambio di denaro.</li>
        <li>Solo spazio espositivo, per portare prodotti e mezzi dentro l'evento.</li>
        <li>Progetti dedicati: un'area, una prova speciale, un contenuto video, la premiazione.</li>
      </ul>
      <p>Scrivici cosa ti serve e cosa puoi mettere a disposizione: ti rispondiamo con una proposta concreta.</p>
    </div>
  </section>

  <section id="espositori" class="wrap section" aria-labelledby="es-h">
    <h2 id="es-h" class="type-h2">Spazio espositivo per la tua azienda</h2>
    <p class="p">Nelle ultime edizioni hanno esposto 4 aziende in un'area attraversata da oltre 10.000 persone in due giorni. Lo spazio comprende superficie assegnata, accesso allo scarico e passaggio dello staff. Corrente elettrica e gazebo su richiesta.</p>
    <p class="hint">Gli spazi sono limitati e assegnati in ordine di richiesta.</p>
  </section>

  <section id="form-sponsor" class="wrap section fs" aria-labelledby="fs-h">
    <div class="fs__t">
      <h2 id="fs-h" class="type-h2">Richiedi il progetto sponsor</h2>
      <p class="type-body-dark">Raccontaci l'azienda e l'evento che ti interessa: prepariamo una proposta con visibilità, materiali e report finale.</p>
      <div class="card card--left"><span class="type-mono text-meta">Presentazione per gli sponsor</span><p>Presentazione eventi 2026 con numeri, foto, mappe e formati di visibilità. Puoi scaricarla subito, oppure spuntare la casella nel modulo e te la mandiamo per email.</p><a class="link-box" href={presentazione} target="_blank" rel="noopener">Scarica la presentazione ↗</a><span class="hint">PDF · {presentazionePeso} · si apre in una nuova pagina</span></div>
      <div class="card card--left"><span class="type-mono text-meta">Sei un espositore?</span><p>Lo spazio esposizione è un canale a sé: scegli «Spazio espositivo» come interesse nel modulo e ti mandiamo misure, costi e planimetria.</p></div>
    </div>
    <form class="form-box" data-mailform data-modulo="sponsor" data-to={email} data-subject="Richiesta progetto sponsor · Inversione A U" novalidate>
      <div class="errbox" role="alert" tabindex="-1" hidden data-errors></div>
      <fieldset>
        <legend>La tua azienda</legend>
        <div class="f-grid">
          <label class="field f-full"><span>Azienda *</span><input type="text" name="azienda" autocomplete="organization" required /></label>
          <label class="field"><span>Referente *</span><input type="text" name="referente" autocomplete="name" required /></label>
          <label class="field"><span>Settore *</span><select name="settore" required>{settori.map(s => <option value={s}>{s}</option>)}</select></label>
          <label class="field"><span>Email *</span><input type="email" name="email" autocomplete="email" required /></label>
          <label class="field"><span>Telefono</span><input type="tel" name="telefono" autocomplete="tel" placeholder="Facoltativo, ma accorcia i tempi" /></label>
          <label class="field"><span>Evento di interesse *</span><select name="evento" required>{eventi.map(e => <option value={e}>{e}</option>)}</select></label>
          <label class="field"><span>Cosa ti interessa *</span><select name="pacchetto" required data-pacchetto>{pacchettiOpz.map(o => <option value={o}>{o}</option>)}</select></label>
          <label class="field"><span>Budget che hai in mente</span><select name="budget">{budget.map(b => <option value={b}>{b}</option>)}</select></label>
          <label class="field f-full"><span>Scrivi qui cosa vorresti ottenere</span><textarea name="note" rows="4" placeholder="Obiettivi, prodotti da promuovere, materiali che avete già"></textarea></label>
        </div>
      </fieldset>
      <label class="chk"><input type="checkbox" name="presentazione" checked /><span>Inviatemi la presentazione per gli sponsor via email</span></label>
      <label class="chk"><input type="checkbox" name="privacy" required /><span>Ho letto l'<a href="/privacy/">informativa privacy</a> e acconsento al trattamento dei dati per rispondere alla richiesta.</span></label>
      <button type="submit" class="btn btn--primary">Invia la richiesta</button>
      <p class="hint">Alla richiesta alleghiamo la presentazione eventi 2026 in PDF. Non usiamo il tuo indirizzo per altro e non lo cediamo a nessuno.</p>
      <p class="form-msg" role="status" aria-live="polite"></p>
    </form>
  </section>
</Base>
<script>
  import '../../../scripts/mailform';
</script>
<style>
  .pg-head{padding-top:var(--sp-4);padding-bottom:var(--sp-2);display:flex;flex-direction:column;gap:12px}
  .pg-head h1{color:#fff;max-width:22ch;text-wrap:balance}
  .lead{color:var(--text-body-on-dark);max-width:60ch;font-size:17px}
  h2{color:#fff}
  .mb{margin-bottom:var(--sp-4)}
  .row-h{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:var(--sp-4)}
  .p{color:#DDD;max-width:70ch;margin-top:16px}
  .cmp{margin-top:var(--sp-4);margin-bottom:12px}
  .tec ul{margin:12px 0}
  .tec{margin-top:var(--sp-5);max-width:80ch}
  .fs{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-6);align-items:start}
  @media(min-width:900px){.fs{grid-template-columns:minmax(0,1fr) minmax(0,1.3fr)}}
  .fs__t{display:flex;flex-direction:column;gap:16px}
  .fs__t p{max-width:56ch}
</style>
