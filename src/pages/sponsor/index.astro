---
/** Sponsor — partner di stagione, sponsor per evento, numeri, CTA. I patrocini restano dentro gli eventi. */
import Base from '../../layouts/Base.astro';
import SponsorBlock from '../../components/SponsorBlock.astro';
import StatBlock from '../../components/StatBlock.astro';
import CTABlock from '../../components/CTABlock.astro';
import { caricaSponsor, senzaAnnuali } from '../../lib/contenuti';
import { canali, seguitoTotale } from '../../data/sponsor';
import { presentazione, presentazionePeso } from '../../data/filesWix';
const sponsor = await caricaSponsor();
const annuali = sponsor.annuali;
const sponsorEvento = (k: string) => senzaAnnuali(sponsor.perEvento(k), annuali);
const spPolo = sponsorEvento('polo'), spLegnaro = sponsorEvento('legnaro');
const numeri = [
  { value: '10.000+', label: 'spettatori a evento' }, { value: 'circa 100', label: 'equipaggi in due giorni' }, { value: '400+', label: 'auto esposte' }, { value: '23', label: 'sponsor' },
  { value: '4', label: 'espositori' }, { value: '8', label: 'fotografi e videomaker' }, { value: '3', label: 'eventi nel 2026' },
];
---
<Base title="Sponsor degli eventi | Inversione A U" description="I partner di stagione di Inversione A U e gli sponsor di Polo Motor Show, Legnaro Motori e Rally Colli Euganei. Come diventare sponsor." active="sponsor">
  <header class="wrap pg-head">
    <p class="type-mono text-meta">I partner di Inversione A U</p>
    <h1 class="type-h1">Gli sponsor degli eventi</h1>
    <p class="lead">Le aziende che sostengono l'intera stagione e quelle legate a un singolo evento. Ogni evento ha poi i suoi sponsor nella pagina dedicata.</p>
  </header>

  <section id="partner-annuali" class="wrap section" aria-labelledby="pa-h">
    <h2 id="pa-h" class="type-h2">Partner di stagione</h2>
    <p class="type-body-dark p">Sono i partner del marchio Inversione A U. Il loro logo è presente in ogni evento della stagione, sui materiali stampati, nei comunicati e su questo sito per tutti i dodici mesi.</p>
    <SponsorBlock sponsors={annuali} columns={4} logoH={64} mono={false} />
  </section>

  <section class="wrap section" aria-labelledby="se-h">
    <h2 id="se-h" class="type-h2">Sponsor dei singoli eventi</h2>
    <p class="type-body-dark p">Un'azienda può scegliere un solo evento invece dell'intera stagione. In quel caso il marchio vive dentro l'evento che ha scelto: percorso, materiali, comunicati e pagina dedicata.</p>
    <div class="ev">
      <div id="sponsor-polo" class="ev__b" style="--acc:#6FC7DB">
        <span class="type-mono ev__k">Polo Motor Show · 13–14 giugno 2026</span>
        <h3 class="type-h3">Sponsor del Polo Motor Show</h3>
        <p class="type-body-dark">Le aziende del circuito cittadino di Selve di Teolo.</p>
        <SponsorBlock sponsors={spPolo} columns={4} logoH={64} mono={false} />
        <a class="type-mono link-line ev__l" href="/eventi/polo-motor-show/#sponsor">Vai alla pagina dell'evento <span class="arrow-x" aria-hidden="true">→</span></a>
      </div>
      <div id="sponsor-legnaro" class="ev__b" style="--acc:#A8D8B4">
        <span class="type-mono ev__k">Legnaro Motori · 15 marzo 2026</span>
        <h3 class="type-h3">Sponsor di Legnaro Motori</h3>
        <p class="type-body-dark">Le aziende della prima edizione del format fuori dai Colli.</p>
        <SponsorBlock sponsors={spLegnaro} columns={4} logoH={64} mono={false} />
        <a class="type-mono link-line ev__l" href="/eventi/legnaro-motori/#sponsor">Vai alla pagina dell'evento <span class="arrow-x" aria-hidden="true">→</span></a>
      </div>
      <div id="sponsor-rally" class="ev__b" style="--acc:#00BA89">
        <span class="type-mono ev__k">1° Rally Colli Euganei · 21–22 novembre 2026</span>
        <h3 class="type-h3">Sponsor del 1° Rally Colli Euganei</h3>
        <p class="type-body-dark">La prima edizione è sostenuta dai partner di stagione. Gli sponsor propri del rally si aggiungono qui man mano che gli accordi si chiudono.</p>
        <div class="ev__row"><span class="pill">Elenco in aggiornamento</span><a class="type-mono link-line ev__l" href="/sponsor/diventa-sponsor/#form-sponsor">Diventa sponsor del rally <span class="arrow-x" aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <section id="numeri-sponsor" class="wrap section" aria-labelledby="ns-h">
    <h2 id="ns-h" class="type-h2 ns__h">Cosa vede uno sponsor a un nostro evento</h2>
    <StatBlock stats={numeri} columns={4} />
  </section>

  <section id="audience" class="hair" aria-labelledby="au-h">
    <div class="wrap section au">
      <div class="au__t">
        <p class="type-mono text-meta">Oltre i giorni di gara</p>
        <h2 id="au-h" class="type-h2">Il pubblico che ci segue tutto l'anno</h2>
        <p class="type-body-dark au__p">Un evento dura due giorni. I canali dell'associazione lavorano per dodici mesi: annunci, dietro le quinte, foto e video delle gare, storie dei piloti. Un marchio che entra in una nostra stagione compare lì, non solo sul percorso.</p>
        <p class="au__tot"><span class="type-mono tabellone au__cifra">{seguitoTotale}</span><span class="au__lab">persone raggiunte sui nostri canali</span></p>
      </div>
      <ul class="au__grid">
        {canali.map(c => (
          <li class="au__c">
            <a href={c.url} target="_blank" rel="noopener">
              <span class="type-mono au__rete">{c.rete}</span>
              <span class="type-mono tabellone au__n">{c.valore}</span>
              <span class="au__nota">{c.nota}</span>
              <span class="type-mono au__h">{c.handle} ↗</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="au__pres">
        <div>
          <h3 class="type-h3">Presentazione eventi 2026</h3>
          <p class="type-body-dark">Numeri, foto, mappe e formati di visibilità dei tre eventi, in un documento solo. È quello che mandiamo alle aziende che ci chiedono una proposta.</p>
        </div>
        <div class="au__dl">
          <a class="btn btn--primary" href={presentazione} target="_blank" rel="noopener">Scarica la presentazione</a>
          <span class="hint">PDF · {presentazionePeso} · si apre in una nuova pagina</span>
        </div>
      </div>
    </div>
  </section>

  <CTABlock kicker="Stagione 2027" title="Porta il tuo marchio sui Colli Euganei" text="Costruiamo ogni proposta sull'azienda che abbiamo davanti. Ti mostriamo dove finisce il tuo marchio e cosa ricevi a fine stagione." image="/foto/polo_esposizione_auto.jpg">
    <a href="/sponsor/diventa-sponsor/#form-sponsor" class="btn btn--primary">Richiedi il progetto sponsor</a>
    <a href="/sponsor/diventa-sponsor/#espositori" class="btn btn--secondary">Chiedi uno spazio espositivo</a>
  </CTABlock>
</Base>
<style>
  .pg-head{padding-top:var(--sp-6);padding-bottom:var(--sp-2);display:flex;flex-direction:column;gap:12px}
  .pg-head h1{color:#fff}
  .lead{color:var(--text-body-on-dark);max-width:60ch;font-size:17px}
  h2{color:#fff;margin-bottom:8px}
  .p{max-width:70ch;margin-bottom:12px}
  .hint{font-family:var(--font-mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--grigio-450);display:block;margin-bottom:var(--sp-4)}
  .ev{display:flex;flex-direction:column;gap:var(--sp-6);margin-top:var(--sp-4)}
  .ev__b{display:flex;flex-direction:column;gap:12px;padding-left:20px;border-left:3px solid var(--acc)}
  .ev__k{color:var(--acc)}
  .ev__b h3{color:#fff}
  /* audience */
  .au{display:flex;flex-direction:column;gap:var(--sp-5)}
  .au__t{display:flex;flex-direction:column;gap:12px}
  .au__p{max-width:64ch}
  .au__tot{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-top:8px}
  .au__cifra{font-size:clamp(40px,7vw,72px);color:#fff;line-height:1}
  .au__lab{color:var(--grigio-450);font-size:15px}
  .au__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--border-on-dark);border:1px solid var(--border-on-dark)}
  @media(min-width:700px){.au__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(min-width:1100px){.au__grid{grid-template-columns:repeat(6,minmax(0,1fr))}}
  .au__c{background:var(--nero)}
  .au__c a{display:flex;flex-direction:column;gap:6px;padding:20px 18px;height:100%;text-decoration:none;transition:background-color var(--dur-fast) var(--ease-out)}
  .au__c a:hover,.au__c a:focus-visible{background:var(--carbone)}
  .au__rete{color:var(--grigio-450);font-size:11px}
  .au__n{color:#fff;font-size:26px;line-height:1.1}
  .au__nota{color:var(--text-body-on-dark);font-size:13px}
  .au__h{color:var(--grigio-450);font-size:11px;margin-top:auto;padding-top:8px;overflow-wrap:anywhere}
  .au__pres{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--sp-4);align-items:center;background:var(--carbone);border:1px solid var(--border-on-dark);padding:var(--sp-4)}
  @media(min-width:900px){.au__pres{grid-template-columns:minmax(0,1.6fr) minmax(0,1fr)}}
  .au__pres h3{color:#fff;margin-bottom:8px}
  .au__dl{display:flex;flex-direction:column;gap:8px;align-items:flex-start}
  @media(min-width:900px){.au__dl{align-items:flex-end}}
  .ev__l{color:#fff;align-self:flex-start}
  .ev__row{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
  .pill{font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--grigio-500);color:var(--grigio-200);padding:3px 8px}
  .ns__h{margin-bottom:var(--sp-4)}
</style>
