---
/**
 * Layout base — Inversione A U
 * Ogni pagina passa title e description (Ondata 5). `active` accende la voce di menu.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description: string;
  active?: '' | 'rally' | 'eventi' | 'associazione' | 'news' | 'media' | 'sponsor';
  /** classe di contesto evento sul <body>: es. "ctx-rally" — il colore vive solo qui */
  bodyClass?: string;
  noindex?: boolean;
  /** immagine di condivisione 1200×630 (path assoluto del sito) */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  /** dati strutturati aggiuntivi (JSON-LD), uno o più oggetti */
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, active = '', bodyClass = '', noindex = false, image = '/img/social/inversione-au.jpg', imageAlt = 'Inversione A U — eventi motorsport sui Colli Euganei', ogType = 'website', jsonld } = Astro.props;
const origin = (Astro.site ?? Astro.url).origin;
const percorso = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(percorso, origin).href;
// immagine social: le foto dal Media Manager (fill w×h) vengono richieste in 1200×630; le nostre immagini social sono già 1200×630
const socialSrc = /static\.wixstatic\.com\/.*\/fill\/w_\d+,h_\d+/.test(image) ? image.replace(/\/fill\/w_\d+,h_\d+/, '/fill/w_1200,h_630') : image;
const ogImage = new URL(socialSrc, origin).href;
const ogDim = /\/fill\/w_1200,h_630/.test(socialSrc) || socialSrc.startsWith('/img/social/');
const ogW = ogDim ? '1200' : '';
const ogH = ogDim ? '630' : '';
const org = {
  '@context': 'https://schema.org', '@type': 'SportsOrganization', '@id': `${origin}/#org`,
  name: 'Inversione A U A.S.D.', alternateName: 'Inversione A U', url: origin, logo: `${origin}/img/logo_positivo_nero.png`,
  email: 'inversione.au3@gmail.com', telephone: '+39 348 570 1233',
  address: { '@type': 'PostalAddress', streetAddress: 'Via Selve 46/B', addressLocality: 'Saccolongo', addressRegion: 'PD', postalCode: '35030', addressCountry: 'IT' },
  sameAs: ['https://www.instagram.com/inversione.au/', 'https://www.facebook.com/inversione.au'],
  sport: 'Motorsport',
};
const ld = [org, ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [])];
---
<!doctype html>
<html lang="it" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace('no-js','js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="Inversione A U" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:image" content={ogImage} />
    {ogW && <meta property="og:image:width" content={ogW} />}
    {ogH && <meta property="og:image:height" content={ogH} />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://static.wixstatic.com" crossorigin />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <SiteHeader active={active} />
    <main id="contenuto">
      <slot />
    </main>
    <SiteFooter />
    <Lightbox />
    <script src="../scripts/movimento.js"></script>
  </body>
</html>
